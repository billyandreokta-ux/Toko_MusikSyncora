
@model TokoMusik.Web.Models.LaporanInventarisViewModel

@{
    ViewData["Title"] = "Laporan Inventaris";

    var totalProduk = Model.ProdukTerlarisRestock.Any()
        ? Model.ProdukTerlarisRestock.Max(x => x.TotalUnitMasuk)
        : 0;

    var totalSupplier = Model.PembelianPerSupplier.Any()
        ? Model.PembelianPerSupplier.Max(x => x.TotalPembelian)
        : 0;
}

<style>
    .report-page {
        padding: 30px 0 55px;
        color: #293b30;
    }

    .report-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .report-heading h1 {
        font-size: 27px;
        font-weight: 750;
        margin-bottom: 5px;
    }

    .report-heading p {
        color: #829087;
        margin: 0;
    }

    .report-button {
        display: inline-block;
        padding: 11px 16px;
        border-radius: 9px;
        background: #176b45;
        color: white;
        text-decoration: none;
        border: none;
        font-size: 13px;
        font-weight: 650;
        cursor: pointer;
    }

    .report-button:hover {
        background: #105638;
        color: white;
    }

    .report-button.secondary {
        background: #edf3ef;
        color: #315640;
    }

    .report-filter {
        display: flex;
        align-items: end;
        flex-wrap: wrap;
        gap: 13px;
        background: white;
        border: 1px solid #e5ece7;
        border-radius: 14px;
        padding: 19px;
        margin-bottom: 22px;
    }

    .report-filter-group {
        flex: 1;
        min-width: 180px;
    }

    .report-filter-group label {
        display: block;
        font-size: 12px;
        font-weight: 650;
        margin-bottom: 7px;
    }

    .report-filter-group input {
        width: 100%;
        min-height: 43px;
        padding: 9px 12px;
        border: 1px solid #dce5df;
        border-radius: 8px;
    }

    .report-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 22px;
    }

    .report-card {
        background: white;
        border: 1px solid #e5ece7;
        border-radius: 13px;
        padding: 19px;
        box-shadow: 0 4px 16px rgba(25, 55, 39, .035);
        min-width: 0;
    }

    .report-card-label {
        color: #829087;
        font-size: 12px;
        margin-bottom: 10px;
    }

    .report-card-value {
        font-size: 25px;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .report-card-description {
        color: #87928b;
        font-size: 11px;
        margin-top: 6px;
    }

    .report-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 20px;
    }

    .report-section {
        background: white;
        border: 1px solid #e5ece7;
        border-radius: 14px;
        padding: 21px;
        min-width: 0;
        margin-bottom: 20px;
    }

    .report-section h2 {
        font-size: 17px;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .report-description {
        color: #87928b;
        font-size: 12px;
        margin-bottom: 21px;
    }

    .report-ranking {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .report-ranking-item {
        min-width: 0;
    }

    .report-ranking-heading {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 12px;
        margin-bottom: 8px;
    }

    .report-ranking-name {
        font-size: 13px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .report-ranking-value {
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .report-progress {
        height: 8px;
        background: #edf2ee;
        border-radius: 20px;
        overflow: hidden;
    }

    .report-progress-fill {
        height: 100%;
        background: #24764f;
        border-radius: 20px;
        min-width: 3px;
    }

    .report-progress-fill.supplier {
        background: #729b7e;
    }

    .report-subtext {
        font-size: 11px;
        color: #87928b;
        margin-top: 6px;
    }

    .report-movement {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
    }

    .report-movement-item {
        background: #f7faf8;
        border-radius: 11px;
        padding: 17px;
    }

    .report-movement-label {
        font-size: 12px;
        color: #829087;
        margin-bottom: 8px;
    }

    .report-movement-value {
        font-size: 24px;
        font-weight: 750;
    }

    .report-movement-value.in {
        color: #207747;
    }

    .report-movement-value.out {
        color: #b33b36;
    }

    .report-table-wrap {
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
    }

    .report-table th {
        text-align: left;
        padding: 12px;
        background: #f6f9f7;
        color: #718078;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .report-table td {
        padding: 13px 12px;
        border-bottom: 1px solid #edf1ee;
        font-size: 13px;
    }

    .report-table tr:last-child td {
        border-bottom: none;
    }

    .report-empty {
        text-align: center;
        color: #87928b;
        padding: 30px 15px !important;
    }

    .report-number {
        font-weight: 700;
        white-space: nowrap;
    }

    .report-period {
        font-size: 12px;
        color: #829087;
        margin-top: 5px;
    }

    @@media (max-width: 992px) {
        .report-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .report-grid {
            grid-template-columns: 1fr;
        }

        .report-heading h1 {
            font-size: 23px;
        }
    }

    @@media (max-width: 480px) {
        .report-summary {
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .report-card {
            padding: 14px;
        }

        .report-card-value {
            font-size: 20px;
        }

        .report-section {
            padding: 15px;
        }

        .report-movement {
            grid-template-columns: 1fr;
        }
    }

    @@media print {
        .report-filter,
        .report-actions,
        .report-heading .report-button {
            display: none !important;
        }

        .report-page {
            padding: 0;
        }

        .report-section,
        .report-card {
            break-inside: avoid;
            box-shadow: none;
        }
    }
</style>

<div class="container report-page">

    <div class="report-heading">
        <div>
            <h1>Laporan Inventaris</h1>
            <p>Ringkasan pembelian dan pergerakan stok produk.</p>
            <div class="report-period">
                Periode:
                @Model.TanggalMulai.ToString("dd MMM yyyy")
                –
                @Model.TanggalSelesai.ToString("dd MMM yyyy")
            </div>
        </div>

        <div class="report-actions">
            <button type="button" class="report-button secondary"
                    onclick="window.print()">
                Cetak Laporan
            </button>

            <a asp-controller="AdminTransaksiStok"
               asp-action="Riwayat"
               class="report-button">
                Riwayat Stok
            </a>
        </div>
    </div>

    @if (TempData["Gagal"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Gagal"]
        </div>
    }

    <form method="get"
          asp-controller="AdminLaporanInventaris"
          asp-action="Index"
          class="report-filter">

        <div class="report-filter-group">
            <label for="tanggalMulai">Tanggal Mulai</label>
            <input type="date"
                   id="tanggalMulai"
                   name="tanggalMulai"
                   value="@Model.TanggalMulai.ToString("yyyy-MM-dd")"
                   required />
        </div>

        <div class="report-filter-group">
            <label for="tanggalSelesai">Tanggal Selesai</label>
            <input type="date"
                   id="tanggalSelesai"
                   name="tanggalSelesai"
                   value="@Model.TanggalSelesai.ToString("yyyy-MM-dd")"
                   required />
        </div>

        <button type="submit" class="report-button">
            Terapkan Filter
        </button>

        <a asp-controller="AdminLaporanInventaris"
           asp-action="Index"
           class="report-button secondary">
            Reset
        </a>
    </form>

    <div class="report-summary">

        <div class="report-card">
            <div class="report-card-label">Total Pembelian Stok</div>
            <div class="report-card-value">
                @Model.TotalNilaiPembelian.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
            </div>
            <div class="report-card-description">
                Nilai transaksi pembelian
            </div>
        </div>

        <div class="report-card">
            <div class="report-card-label">Total Stok Masuk</div>
            <div class="report-card-value">
                @Model.TotalUnitMasuk.ToString("N0")
            </div>
            <div class="report-card-description">
                @Model.TotalTransaksiMasuk transaksi
            </div>
        </div>

        <div class="report-card">
            <div class="report-card-label">Total Stok Keluar</div>
            <div class="report-card-value">
                @Model.TotalUnitKeluar.ToString("N0")
            </div>
            <div class="report-card-description">
                @Model.TotalTransaksiKeluar transaksi
            </div>
        </div>

        <div class="report-card">
            <div class="report-card-label">Produk Direstock</div>
            <div class="report-card-value">
                @Model.JumlahProdukDirestock
            </div>
            <div class="report-card-description">
                Produk berbeda yang dibeli
            </div>
        </div>

    </div>

    <div class="report-grid">

        <section class="report-section">
            <h2>Produk Paling Banyak Direstock</h2>
            <div class="report-description">
                Maksimal 10 produk berdasarkan jumlah unit masuk.
            </div>

            @if (Model.ProdukTerlarisRestock.Any())
            {
                <div class="report-ranking">
                    @foreach (var item in Model.ProdukTerlarisRestock)
                    {
                        var persentase = totalProduk > 0
                            ? (double)item.TotalUnitMasuk / totalProduk * 100
                            : 0;

                        <div class="report-ranking-item">
                            <div class="report-ranking-heading">
                                <div>
                                    <div class="report-ranking-name">
                                        @item.NamaProduk
                                    </div>
                                    <div class="report-subtext">
                                        @item.KodeProduk · @item.FrekuensiRestock kali restock
                                    </div>
                                </div>

                                <div class="report-ranking-value">
                                    @item.TotalUnitMasuk.ToString("N0") unit
                                </div>
                            </div>

                            <div class="report-progress">
                                <div class="report-progress-fill"
                                     style="width: @persentase.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                </div>
                            </div>

                            <div class="report-subtext">
                                Nilai pembelian:
                                @item.TotalPembelian.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="report-empty">
                    Belum ada transaksi pembelian pada periode ini.
                </div>
            }
        </section>

        <section class="report-section">
            <h2>Pembelian per Supplier</h2>
            <div class="report-description">
                Maksimal 10 supplier berdasarkan nilai pembelian.
            </div>

            @if (Model.PembelianPerSupplier.Any())
            {
                <div class="report-ranking">
                    @foreach (var item in Model.PembelianPerSupplier)
                    {
                        var persentase = totalSupplier > 0
                            ? (double)(item.TotalPembelian / totalSupplier) * 100
                            : 0;

                        <div class="report-ranking-item">
                            <div class="report-ranking-heading">
                                <div>
                                    <div class="report-ranking-name">
                                        @item.NamaSupplier
                                    </div>
                                    <div class="report-subtext">
                                        @item.TotalTransaksi transaksi ·
                                        @item.TotalUnit unit
                                    </div>
                                </div>

                                <div class="report-ranking-value">
                                    @item.TotalPembelian.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                                </div>
                            </div>

                            <div class="report-progress">
                                <div class="report-progress-fill supplier"
                                     style="width: @persentase.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="report-empty">
                    Belum ada transaksi supplier pada periode ini.
                </div>
            }
        </section>

    </div>

    <section class="report-section">
        <h2>Ringkasan Pergerakan Stok</h2>
        <div class="report-description">
            Perbandingan stok masuk dan stok keluar pada periode terpilih.
        </div>

        <div class="report-movement">
            <div class="report-movement-item">
                <div class="report-movement-label">Stok Masuk</div>
                <div class="report-movement-value in">
                    +@Model.TotalUnitMasuk.ToString("N0") unit
                </div>
                <div class="report-subtext">
                    @Model.TotalTransaksiMasuk transaksi pembelian
                </div>
            </div>

            <div class="report-movement-item">
                <div class="report-movement-label">Stok Keluar</div>
                <div class="report-movement-value out">
                    -@Model.TotalUnitKeluar.ToString("N0") unit
                </div>
                <div class="report-subtext">
                    @Model.TotalTransaksiKeluar transaksi stok keluar
                </div>
            </div>
        </div>
    </section>

    <section class="report-section">
        <h2>Detail Pembelian per Supplier</h2>
        <div class="report-description">
            Rincian transaksi pembelian berdasarkan supplier.
        </div>

        <div class="report-table-wrap">
            <table class="report-table">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Nama Supplier</th>
                        <th>Transaksi</th>
                        <th>Total Unit</th>
                        <th>Total Pembelian</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.PembelianPerSupplier.Any())
                    {
                        var nomor = 1;

                        @foreach (var item in Model.PembelianPerSupplier)
                        {
                            <tr>
                                <td>@nomor</td>
                                <td class="report-number">@item.NamaSupplier</td>
                                <td>@item.TotalTransaksi</td>
                                <td>@item.TotalUnit.ToString("N0")</td>
                                <td class="report-number">
                                    @item.TotalPembelian.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                                </td>
                            </tr>

                            nomor++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="report-empty">
                                Tidak ada data pembelian.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="report-actions" style="display:flex; justify-content:flex-end; gap:10px;">
        <button type="button"
                class="report-button secondary"
                onclick="window.print()">
            Cetak Laporan
        </button>

        <a asp-controller="AdminDashboard"
           asp-action="Index"
           class="report-button">
            Kembali ke Dashboard
        </a>
    </div>

</div>