
@model TokoMusik.Web.Models.LaporanViewModel

@{
    ViewData["Title"] = "Laporan";

    var nilaiMaksimalProduk = Model.ProdukTerlaris.Any()
        ? Math.Max(1, Model.ProdukTerlaris.Max(x => x.JumlahTerjual))
        : 1;

    var nilaiMaksimalSupplier = Model.PembelianPerSupplier.Any()
        ? Math.Max(1, Model.PembelianPerSupplier.Max(x => x.TotalPembelian))
        : 1;

    var nilaiMaksimalKategori = Model.PengeluaranPerKategori.Any()
        ? Math.Max(1, Model.PengeluaranPerKategori.Max(x => x.TotalPengeluaran))
        : 1;
}

<style>
    .report-page {
        padding: 28px 0 55px;
        color: #26382e;
    }

    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .report-header h1 {
        font-size: 28px;
        font-weight: 800;
        margin: 0 0 7px;
        color: #173d2b;
    }

    .report-header p {
        color: #78847c;
        margin: 0;
    }

    .report-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .report-btn {
        border: 0;
        border-radius: 10px;
        padding: 11px 17px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        cursor: pointer;
    }

    .report-btn-primary {
        background: #174d35;
        color: white;
    }

    .report-btn-light {
        background: #edf3ee;
        color: #28533b;
    }

    .report-filter {
        background: white;
        border: 1px solid #e5ebe6;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 22px;
        box-shadow: 0 5px 18px rgba(26, 56, 39, .04);
    }

    .report-filter h3 {
        font-size: 15px;
        font-weight: 800;
        margin: 0 0 15px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 14px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 7px;
        color: #627168;
    }

    .filter-field input {
        width: 100%;
        border: 1px solid #dce5de;
        border-radius: 9px;
        padding: 11px 12px;
        outline: none;
        color: #26382e;
    }

    .filter-field input:focus {
        border-color: #367d55;
        box-shadow: 0 0 0 3px rgba(54, 125, 85, .10);
    }

    .report-nav {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding: 4px 0 15px;
        margin-bottom: 15px;
    }

    .report-nav a {
        flex: 0 0 auto;
        text-decoration: none;
        background: #edf3ee;
        color: #365442;
        padding: 10px 15px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
    }

    .report-nav a:hover {
        background: #dceade;
    }

    .report-section {
        margin-top: 28px;
        scroll-margin-top: 20px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 15px;
    }

    .section-heading h2 {
        font-size: 19px;
        font-weight: 800;
        color: #204a33;
        margin: 0;
    }

    .section-heading span {
        color: #87938b;
        font-size: 12px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e6ece7;
        border-radius: 15px;
        padding: 19px;
        min-width: 0;
        box-shadow: 0 5px 18px rgba(26, 56, 39, .035);
    }

    .summary-card .summary-label {
        color: #78877d;
        font-size: 12px;
        font-weight: 650;
        margin-bottom: 12px;
    }

    .summary-card .summary-value {
        color: #1d4931;
        font-size: 22px;
        font-weight: 850;
        overflow-wrap: anywhere;
    }

    .summary-card .summary-note {
        color: #9aa49d;
        font-size: 11px;
        margin-top: 7px;
    }

    .report-panel {
        background: white;
        border: 1px solid #e5ebe6;
        border-radius: 15px;
        padding: 20px;
        margin-top: 15px;
        box-shadow: 0 5px 18px rgba(26, 56, 39, .035);
    }

    .report-panel h3 {
        font-size: 14px;
        font-weight: 800;
        margin: 0 0 17px;
        color: #34523f;
    }

    .report-table-wrap {
        overflow-x: auto;
        width: 100%;
    }

    .report-table {
        width: 100%;
        min-width: 720px;
        border-collapse: collapse;
        font-size: 12px;
    }

    .report-table th {
        background: #f3f7f3;
        color: #607168;
        font-size: 11px;
        font-weight: 800;
        text-align: left;
        padding: 13px 12px;
        white-space: nowrap;
    }

    .report-table td {
        padding: 13px 12px;
        border-bottom: 1px solid #edf1ed;
        color: #435349;
        vertical-align: middle;
    }

    .report-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .report-table tbody tr:hover {
        background: #fafcf9;
    }

    .text-right {
        text-align: right !important;
        white-space: nowrap;
    }

    .text-center {
        text-align: center !important;
    }

    .status-pill {
        display: inline-block;
        border-radius: 30px;
        padding: 5px 9px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-berhasil,
    .status-selesai,
    .status-dibayar {
        background: #e4f4e9;
        color: #237344;
    }

    .status-pending,
    .status-menunggu_bayar {
        background: #fff3d9;
        color: #9b6a12;
    }

    .status-gagal,
    .status-dibatalkan {
        background: #fde9e7;
        color: #b4443b;
    }

    .status-diproses,
    .status-dikirim {
        background: #e8f0fb;
        color: #38649a;
    }

    .bar-list {
        display: flex;
        flex-direction: column;
        gap: 17px;
    }

    .bar-item {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .bar-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        font-size: 12px;
    }

    .bar-info strong {
        color: #344b3c;
        overflow-wrap: anywhere;
    }

    .bar-info span {
        color: #64746a;
        white-space: nowrap;
    }

    .bar-track {
        height: 9px;
        background: #edf2ee;
        border-radius: 20px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: #43845a;
        border-radius: 20px;
        min-width: 3px;
    }

    .empty-report {
        padding: 28px 15px;
        text-align: center;
        color: #98a39b;
        font-size: 13px;
    }

    .report-footnote {
        color: #89958c;
        font-size: 11px;
        margin-top: 12px;
        line-height: 1.6;
    }

    .report-total-line {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding-top: 14px;
        margin-top: 12px;
        border-top: 1px solid #edf1ed;
        font-size: 12px;
        font-weight: 800;
    }

    .report-total-line strong {
        color: #1d4931;
    }

    @@media (max-width: 1000px) {
        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .report-page {
            padding-top: 18px;
        }

        .report-header h1 {
            font-size: 23px;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .summary-grid {
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .summary-card {
            padding: 14px;
        }

        .summary-card .summary-value {
            font-size: 18px;
        }

        .report-panel {
            padding: 14px;
        }
    }

    @@media print {
        @@page {
            size: landscape;
            margin: 12mm;
        }

        body {
            background: white !important;
            color: #222 !important;
        }

        .report-page {
            padding: 0 !important;
        }

        .report-actions,
        .report-filter,
        .report-nav {
            display: none !important;
        }

        .summary-card,
        .report-panel {
            box-shadow: none !important;
            break-inside: avoid;
        }

        .report-section {
            break-inside: avoid;
        }

        .report-table {
            min-width: 0;
            font-size: 9px;
        }

        .report-table th,
        .report-table td {
            padding: 7px 6px;
        }
    }
</style>

<div class="container report-page">

    <div class="report-header">
        <div>
            <h1>Laporan Bisnis</h1>
            <p>Pusat informasi penjualan, pembayaran, pembelian stok, dan pengeluaran Syncora.</p>
        </div>

        <div class="report-actions">
            <button type="button" class="report-btn report-btn-light" onclick="window.print()">
                Cetak Laporan
            </button>
            <a asp-controller="AdminDashboard" asp-action="Index" class="report-btn report-btn-primary">
                Kembali ke Dashboard
            </a>
        </div>
    </div>

    <form asp-controller="AdminLaporan" asp-action="Index" method="get" class="report-filter">
        <h3>Filter Periode Laporan</h3>

        <div class="filter-grid">
            <div class="filter-field">
                <label for="tanggalMulai">Tanggal Mulai</label>
                <input type="date"
                       id="tanggalMulai"
                       name="tanggalMulai"
                       value="@Model.TanggalMulai.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="filter-field">
                <label for="tanggalSelesai">Tanggal Selesai</label>
                <input type="date"
                       id="tanggalSelesai"
                       name="tanggalSelesai"
                       value="@Model.TanggalSelesai.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <button type="submit" class="report-btn report-btn-primary">
                Terapkan Filter
            </button>
        </div>

        <div class="report-footnote">
            Periode laporan:
            <strong>@Model.TanggalMulai.ToString("dd MMM yyyy")</strong>
            sampai
            <strong>@Model.TanggalSelesai.ToString("dd MMM yyyy")</strong>
        </div>
    </form>

    <nav class="report-nav">
        <a href="#penjualan">Penjualan</a>
        <a href="#pembayaran">Pembayaran</a>
        <a href="#pembelian">Pembelian Stok</a>
        <a href="#pengeluaran">Pengeluaran</a>
    </nav>

    <!-- PENJUALAN -->
    <section class="report-section" id="penjualan">
        <div class="section-heading">
            <h2>Laporan Penjualan</h2>
            <span>Pesanan yang sudah dibayar dan diproses</span>
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">Total Penjualan</div>
                <div class="summary-value">Rp @Model.TotalPenjualan.ToString("N0")</div>
                <div class="summary-note">Nilai pesanan pada periode terpilih</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Jumlah Pesanan</div>
                <div class="summary-value">@Model.TotalPesanan.ToString("N0")</div>
                <div class="summary-note">Pesanan yang masuk perhitungan omzet</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Produk Terjual</div>
                <div class="summary-value">@Model.TotalProdukTerjual.ToString("N0")</div>
                <div class="summary-note">Akumulasi kuantitas produk</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Produk Terlaris</div>
                <div class="summary-value">
                    @(Model.ProdukTerlaris.FirstOrDefault()?.JumlahTerjual.ToString("N0") ?? "0")
                </div>
                <div class="summary-note">
                    @(Model.ProdukTerlaris.FirstOrDefault()?.NamaProduk ?? "Belum ada penjualan")
                </div>
            </div>
        </div>

        <div class="report-panel">
            <h3>10 Produk Terlaris</h3>

            @if (Model.ProdukTerlaris.Any())
            {
                <div class="bar-list">
                    @foreach (var item in Model.ProdukTerlaris)
                    {
                        var persen = (double)item.JumlahTerjual / nilaiMaksimalProduk * 100;

                        <div class="bar-item">
                            <div class="bar-info">
                                <strong>@item.NamaProduk <small>(@item.KodeProduk)</small></strong>
                                <span>@item.JumlahTerjual unit</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill" style="width: @persen.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-report">Belum ada data penjualan produk pada periode ini.</div>
            }
        </div>

        <div class="report-panel">
            <h3>Rincian Transaksi Penjualan</h3>

            <div class="report-table-wrap">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>No. Pesanan</th>
                            <th>Tanggal</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th class="text-right">Total Bayar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DaftarPenjualan.Any())
                        {
                            @foreach (var item in Model.DaftarPenjualan)
                            {
                                <tr>
                                    <td>#@item.IdPemesanan</td>
                                    <td>@item.Tanggal.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@item.NamaCustomer</td>
                                    <td>
                                        <span class="status-pill status-@item.Status">
                                            @item.Status.Replace("_", " ")
                                        </span>
                                    </td>
                                    <td class="text-right">Rp @item.TotalBayar.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="empty-report">Belum ada transaksi penjualan.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="report-footnote">Maksimal 500 transaksi terbaru ditampilkan.</div>
        </div>
    </section>

    <!-- PEMBAYARAN -->
    <section class="report-section" id="pembayaran">
        <div class="section-heading">
            <h2>Laporan Pembayaran</h2>
            <span>Berdasarkan tanggal pembayaran</span>
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">Pembayaran Berhasil</div>
                <div class="summary-value">@Model.JumlahPembayaranBerhasil</div>
                <div class="summary-note">Transaksi berhasil</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Total Pembayaran Berhasil</div>
                <div class="summary-value">Rp @Model.TotalPembayaranBerhasil.ToString("N0")</div>
                <div class="summary-note">Akumulasi pembayaran berhasil</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Pembayaran Pending</div>
                <div class="summary-value">@Model.JumlahPembayaranPending</div>
                <div class="summary-note">Menunggu verifikasi atau penyelesaian</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Pembayaran Gagal</div>
                <div class="summary-value">@Model.JumlahPembayaranGagal</div>
                <div class="summary-note">Transaksi pembayaran gagal</div>
            </div>
        </div>

        <div class="report-panel">
            <h3>Riwayat Pembayaran</h3>

            <div class="report-table-wrap">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>ID Pembayaran</th>
                            <th>No. Pesanan</th>
                            <th>Tanggal Bayar</th>
                            <th>ID Metode</th>
                            <th>Status</th>
                            <th class="text-right">Jumlah Bayar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DaftarPembayaran.Any())
                        {
                            @foreach (var item in Model.DaftarPembayaran)
                            {
                                <tr>
                                    <td>#@item.IdPayment</td>
                                    <td>#@item.IdPemesanan</td>
                                    <td>@item.TanggalBayar.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@item.IdMetode</td>
                                    <td>
                                        <span class="status-pill status-@item.Status">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-right">Rp @item.JumlahBayar.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="empty-report">Belum ada data pembayaran.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="report-footnote">ID metode pembayaran ditampilkan karena struktur tabel metode_pembayaran belum digunakan untuk mengambil nama metode.</div>
        </div>
    </section>

    <!-- PEMBELIAN STOK -->
    <section class="report-section" id="pembelian">
        <div class="section-heading">
            <h2>Laporan Pembelian Stok</h2>
            <span>Riwayat restock dari supplier</span>
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">Total Pembelian</div>
                <div class="summary-value">Rp @Model.TotalNilaiPembelian.ToString("N0")</div>
                <div class="summary-note">Nilai pembelian stok</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Transaksi Pembelian</div>
                <div class="summary-value">@Model.JumlahTransaksiPembelian</div>
                <div class="summary-note">Jumlah transaksi restock</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Unit Dibeli</div>
                <div class="summary-value">@Model.TotalUnitDibeli.ToString("N0")</div>
                <div class="summary-note">Akumulasi unit masuk</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Supplier Terlibat</div>
                <div class="summary-value">@Model.PembelianPerSupplier.Count</div>
                <div class="summary-note">Supplier dengan transaksi pada periode ini</div>
            </div>
        </div>

        <div class="report-panel">
            <h3>Pembelian Berdasarkan Supplier</h3>

            @if (Model.PembelianPerSupplier.Any())
            {
                <div class="bar-list">
                    @foreach (var item in Model.PembelianPerSupplier)
                    {
                        var persen = (double)item.TotalPembelian / (double)nilaiMaksimalSupplier * 100;

                        <div class="bar-item">
                            <div class="bar-info">
                                <strong>@item.NamaSupplier</strong>
                                <span>Rp @item.TotalPembelian.ToString("N0")</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill" style="width: @persen.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                            <div class="report-footnote">
                                @item.JumlahTransaksi transaksi · @item.TotalUnit unit
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-report">Belum ada pembelian stok pada periode ini.</div>
            }
        </div>

        <div class="report-panel">
            <h3>Rincian Pembelian Stok</h3>

            <div class="report-table-wrap">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>ID Pembelian</th>
                            <th>Tanggal</th>
                            <th>Supplier</th>
                            <th>Produk</th>
                            <th class="text-right">Jumlah</th>
                            <th class="text-right">Harga Beli</th>
                            <th class="text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DaftarPembelian.Any())
                        {
                            @foreach (var item in Model.DaftarPembelian)
                            {
                                <tr>
                                    <td>#@item.IdPurchase</td>
                                    <td>@item.Tanggal.ToString("dd MMM yyyy")</td>
                                    <td>@item.NamaSupplier</td>
                                    <td>@item.NamaProduk</td>
                                    <td class="text-right">@item.Jumlah</td>
                                    <td class="text-right">Rp @item.HargaBeli.ToString("N0")</td>
                                    <td class="text-right">Rp @item.Total.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="empty-report">Belum ada transaksi pembelian stok.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="report-total-line">
                <span>Total Nilai Pembelian</span>
                <strong>Rp @Model.TotalNilaiPembelian.ToString("N0")</strong>
            </div>
        </div>
    </section>

    <!-- PENGELUARAN -->
    <section class="report-section" id="pengeluaran">
        <div class="section-heading">
            <h2>Laporan Pengeluaran</h2>
            <span>Pengeluaran operasional bisnis</span>
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">Total Pengeluaran</div>
                <div class="summary-value">Rp @Model.TotalPengeluaran.ToString("N0")</div>
                <div class="summary-note">Total pada periode terpilih</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Jumlah Transaksi</div>
                <div class="summary-value">@Model.JumlahTransaksiPengeluaran</div>
                <div class="summary-note">Transaksi pengeluaran tercatat</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Kategori Pengeluaran</div>
                <div class="summary-value">@Model.PengeluaranPerKategori.Count</div>
                <div class="summary-note">Kategori yang memiliki transaksi</div>
            </div>

            <div class="summary-card">
                <div class="summary-label">Rata-rata Pengeluaran</div>
                <div class="summary-value">
                    Rp @((Model.JumlahTransaksiPengeluaran > 0
                        ? Model.TotalPengeluaran / Model.JumlahTransaksiPengeluaran
                        : 0).ToString("N0"))
                </div>
                <div class="summary-note">Rata-rata per transaksi</div>
            </div>
        </div>

        <div class="report-panel">
            <h3>Pengeluaran Berdasarkan Kategori</h3>

            @if (Model.PengeluaranPerKategori.Any())
            {
                <div class="bar-list">
                    @foreach (var item in Model.PengeluaranPerKategori)
                    {
                        var persen = (double)item.TotalPengeluaran / (double)nilaiMaksimalKategori * 100;

                        <div class="bar-item">
                            <div class="bar-info">
                                <strong>@item.Kategori</strong>
                                <span>Rp @item.TotalPengeluaran.ToString("N0")</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill" style="width: @persen.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                            <div class="report-footnote">@item.JumlahTransaksi transaksi</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-report">Belum ada data pengeluaran pada periode ini.</div>
            }
        </div>

        <div class="report-panel">
            <h3>Riwayat Pengeluaran</h3>

            <div class="report-table-wrap">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>ID Pengeluaran</th>
                            <th>Tanggal</th>
                            <th>Kategori</th>
                            <th>Keterangan</th>
                            <th class="text-right">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DaftarPengeluaran.Any())
                        {
                            @foreach (var item in Model.DaftarPengeluaran)
                            {
                                <tr>
                                    <td>#@item.IdPengeluaran</td>
                                    <td>@item.Tanggal.ToString("dd MMM yyyy")</td>
                                    <td>@item.Kategori</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Keterangan) ? "-" : item.Keterangan)</td>
                                    <td class="text-right">Rp @item.Jumlah.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="empty-report">Belum ada transaksi pengeluaran.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="report-total-line">
                <span>Total Pengeluaran</span>
                <strong>Rp @Model.TotalPengeluaran.ToString("N0")</strong>
            </div>
        </div>
    </section>

    <div class="report-footnote" style="text-align:center; margin-top:30px;">
        Syncora · Laporan dibuat berdasarkan data yang tersimpan pada database.
    </div>
</div>
