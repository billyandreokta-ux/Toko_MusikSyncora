
@model List<TokoMusik.Web.Models.AdminPembayaranViewModel>

@{
    ViewData["Title"] = "Verifikasi Pembayaran";
}

<div class="dashboard-container">
    <div class="dashboard-heading">
        <div>
            <h2>Verifikasi Pembayaran</h2>
            <p class="text-secondary">
                Periksa bukti pembayaran pelanggan dan tentukan hasil verifikasinya.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-custom">
            Dashboard Admin
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="dashboard-section">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <h4>Belum Ada Transaksi</h4>
                <p class="text-secondary">
                    Data pembayaran pelanggan akan muncul di sini.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>No. Pesanan</th>
                            <th>Pelanggan</th>
                            <th>Metode</th>
                            <th>Tanggal</th>
                            <th>Jumlah</th>
                            <th>Status Pembayaran</th>
                            <th>Status Pesanan</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.IdPemesanan</td>
                                <td>
                                    <strong>@item.NamaCustomer</strong>
                                    <div class="small text-secondary">
                                        @item.Username
                                    </div>
                                </td>
                                <td>@item.NamaMetode</td>
                                <td>@item.TglBayar.ToString("dd MMM yyyy HH:mm")</td>
                                <td>Rp @item.JumlahBayar.ToString("N0")</td>
                                <td>
                                    <span class="status-badge">
                                        @item.StatusPembayaran
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge">
                                        @item.StatusPesanan
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="AdminPembayaran"
                                       asp-action="Detail"
                                       asp-route-id="@item.IdPayment"
                                       class="btn btn-outline-custom btn-sm">
                                        Periksa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
