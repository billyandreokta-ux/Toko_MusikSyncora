            .sync-order-data:first-child {
                padding-top: 0;
                border-top: none;
            }

        .sync-order-top {
            flex-wrap: wrap;
        }

        .sync-order-top-statuses {
            width: 100%;
            align-items: flex-start;
            padding-left: 49px;
        }
    }
</style>

<div class="sync-orders-page">

    <!-- HEADER -->
    <div class="sync-orders-heading">
        <div>
            <div class="sync-orders-eyebrow">ORDER HISTORY</div>
            <h1>Pesanan Saya</h1>
            <p>Pantau produk, pembayaran, dan perjalanan pesanan kamu.</p>
        </div>

        <div class="sync-orders-heading-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16v16H4z" />
                <path d="M8 8h8M8 12h8M8 16h5" />
            </svg>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success sync-orders-alert">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger sync-orders-alert">
            @TempData["Error"]
        </div>
    }

    <!-- SUMMARY -->
    <div class="sync-orders-summary">

        <div class="sync-orders-summary-card">
            <div class="sync-orders-summary-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3h12l3 4v14H3V7l3-4z" />
                    <path d="M3 7h18M8 11h8M8 15h8" />
                </svg>
            </div>
            <div>
                <span>Total Pesanan</span>
                <strong>@daftarPesanan.Count</strong>
            </div>
        </div>

        <div class="sync-orders-summary-card">
            <div class="sync-orders-summary-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="3" />
                    <path d="M2 10h20M7 15h3" />
                </svg>
            </div>
            <div>
                <span>Total Transaksi</span>
                <strong>@daftarPesanan.Sum(x => x.TotalBayar).ToString("C0", rupiah)</strong>
            </div>
        </div>

    </div>

    <!-- ORDER HISTORY -->
    <div class="sync-orders-section-heading">
        <h3>Riwayat Transaksi</h3>
        <span id="jumlahPesananTampil">@daftarPesanan.Count PESANAN</span>
    </div>

    <!-- KATEGORI PESANAN -->
    <div class="sync-orders-tabs" role="group" aria-label="Kategori pesanan">

        <button type="button"
                class="sync-orders-tab active"
                data-filter="all">
            Semua Pesanan
            <span class="sync-orders-tab-count">@daftarPesanan.Count</span>
        </button>

        <button type="button"
                class="sync-orders-tab"
                data-filter="orders">
            Pesanan
            <span class="sync-orders-tab-count">@(daftarPesanan.Count - jumlahRetur)</span>
        </button>

        <button type="button"
                class="sync-orders-tab"
                data-filter="returns">
            Pengajuan Pengembalian
            <span class="sync-orders-tab-count">@jumlahRetur</span>
        </button>

    </div>

    @if (!daftarPesanan.Any())
    {
        <div class="sync-orders-empty">

            <div class="sync-orders-empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3h2l2.2 12.2a2 2 0 0 0 2 1.8h8.6a2 2 0 0 0 2-1.6L22 8H6" />
                    <circle cx="10" cy="21" r="1" />
                    <circle cx="18" cy="21" r="1" />
                </svg>
            </div>

            <h3>Belum Ada Pesanan</h3>
            <p>Pesanan yang kamu buat akan muncul di halaman ini.</p>

            <a asp-controller="Produk"
               asp-action="Index"
               class="sync-orders-shop-btn">
                Mulai Belanja
            </a>

        </div>
    }
    else
    {
        <div class="sync-order-list" id="daftarPesanan">

            @foreach (var item in daftarPesanan)
            {
                bool memilikiPengajuanRetur =
                    !string.IsNullOrWhiteSpace(item.StatusRetur);

                <article class="sync-order-card"
                         data-has-return="@(memilikiPengajuanRetur ? "true" : "false")">

                    <!-- ORDER HEADER -->
                    <div class="sync-order-top">

                        <div class="sync-order-number">
                            <div class="sync-order-number-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 3h12l3 4v14H3V7l3-4z" />
                                    <path d="M3 7h18M8 12h8" />
                                </svg>
                            </div>

                            <div>
                                <span>NOMOR PESANAN</span>
                                <strong>#@item.IdPemesanan</strong>
                            </div>
                        </div>

                        <div class="sync-order-top-statuses">
                            <span class="sync-order-status @StatusClass(item.StatusTampilan)">
                                @FormatStatus(item.StatusTampilan)
                            </span>

                            @if (!string.IsNullOrWhiteSpace(item.StatusRetur))
                            {
                                <span class="sync-order-return-status @StatusReturClass(item.StatusRetur)">
                                    @StatusReturText(item.StatusRetur)
                                </span>
                            }
                        </div>

                    </div>

                    <!-- PRODUCTS -->
                    <div class="sync-order-products">

                        <div class="sync-order-products-heading">
                            PRODUK YANG DIPESAN
                        </div>

                        @if (item.Items != null && item.Items.Any())
                        {
                            @foreach (var produk in item.Items)
                            {
                                <div class="sync-order-product">

                                    <div class="sync-order-product-image">
                                        <img src="@FotoProduk(produk.Foto)"
                                             alt="@produk.NamaProduk"
                                             loading="lazy"
                                             onerror="this.onerror=null;this.style.display='none';" />
                                    </div>

                                    <div class="sync-order-product-info">
                                        <strong>@produk.NamaProduk</strong>
                                        <small>Kode Produk: @produk.KodeProduk</small>
                                        <span>
                                            @produk.Jumlah × @produk.HargaSatuan.ToString("C0", rupiah)
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(produk.StatusRetur))
                                        {
                                            <div class="sync-order-product-return">
                                                <span class="sync-order-return-status @StatusReturClass(produk.StatusRetur)">
                                                    @StatusReturText(produk.StatusRetur)
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    <div class="sync-order-product-subtotal">
                                        @produk.Subtotal.ToString("C0", rupiah)
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-secondary mb-0">
                                Informasi produk tidak tersedia.
                            </p>
                        }

                    </div>

                    <!-- ORDER INFORMATION -->
                    <div class="sync-order-information">

                        <div class="sync-order-data">
                            <span>Tanggal Pesanan</span>
                            <strong>
                                @item.TglPesan.ToString("dd MMMM yyyy, HH:mm")
                            </strong>
                        </div>

                        <div class="sync-order-data">
                            <span>Metode Pembayaran</span>
                            <strong>@item.NamaMetode</strong>
                        </div>

                        <div class="sync-order-data">
                            <span>Total Pembayaran</span>
                            <strong class="sync-order-total">
                                @item.TotalBayar.ToString("C0", rupiah)
                            </strong>
                        </div>

                    </div>

                    <!-- FOOTER -->
                    <div class="sync-order-footer">

                        <a asp-controller="PesananSaya"
                           asp-action="Detail"
                           asp-route-id="@item.IdPemesanan"
                           class="sync-order-detail-btn">

                            Lihat Detail Pesanan

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>

                        </a>

                    </div>

                </article>
            }

        </div>

        <!-- PESANAN KOSONG UNTUK FILTER -->
        <div class="sync-orders-empty" id="pesananFilterKosong" hidden>

            <div class="sync-orders-empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16v16H4z" />
                    <path d="M8 9h8M8 13h5" />
                </svg>
            </div>

            <h3 id="pesananFilterJudul">Belum Ada Pengajuan Pengembalian</h3>
            <p id="pesananFilterDeskripsi">
                Pengajuan pengembalian produk kamu akan muncul di sini.
            </p>

        </div>
    }

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const tabButtons = document.querySelectorAll(".sync-orders-tab");
        const orderCards = document.querySelectorAll(".sync-order-card");
        const emptyPanel = document.getElementById("pesananFilterKosong");
        const emptyTitle = document.getElementById("pesananFilterJudul");
        const emptyDescription = document.getElementById("pesananFilterDeskripsi");
        const countLabel = document.getElementById("jumlahPesananTampil");

        if (!tabButtons.length || !orderCards.length) {
            return;
        }

        function filterPesanan(filter) {

            let jumlahTampil = 0;

            orderCards.forEach(function (card) {

                const memilikiRetur =
                    card.dataset.hasReturn === "true";

                let tampil = true;

                if (filter === "orders") {
                    tampil = !memilikiRetur;
                }
                else if (filter === "returns") {
                    tampil = memilikiRetur;
                }

                card.hidden = !tampil;

                if (tampil) {
                    jumlahTampil++;
                }
            });

            if (countLabel) {
                countLabel.textContent = jumlahTampil + " PESANAN";
            }

            if (emptyPanel) {
                emptyPanel.hidden = jumlahTampil !== 0;
            }

            if (jumlahTampil === 0 && emptyTitle && emptyDescription) {

                if (filter === "returns") {
                    emptyTitle.textContent = "Belum Ada Pengajuan Pengembalian";
                    emptyDescription.textContent =
                        "Pengajuan pengembalian produk kamu akan muncul di sini.";
                }
                else {
                    emptyTitle.textContent = "Tidak Ada Pesanan";
                    emptyDescription.textContent =
                        "Belum ada pesanan pada kategori ini.";
                }
            }
        }

        tabButtons.forEach(function (button) {

            button.addEventListener("click", function () {

                const filter = button.dataset.filter || "all";

                tabButtons.forEach(function (tab) {
                    tab.classList.remove("active");
                });

                button.classList.add("active");

                filterPesanan(filter);
            });

        });

    });
</script>
