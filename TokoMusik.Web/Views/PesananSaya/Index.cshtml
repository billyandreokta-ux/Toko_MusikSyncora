
@model IEnumerable<TokoMusik.Web.Models.PesananViewModel>

@{
    ViewData["Title"] = "Pesanan Saya";

    var daftarPesanan = Model?.ToList() ?? new List<TokoMusik.Web.Models.PesananViewModel>();

    string FormatStatus(string? status)
    {
        return (status ?? "").Trim().ToLowerInvariant() switch
        {
            "menunggu_bayar" => "Menunggu Pembayaran",
            "diproses" => "Sedang Diproses",
            "dikirim" => "Dalam Pengiriman",
            "selesai" => "Pesanan Selesai",
            "dibatalkan" => "Dibatalkan",
            "retur" => "Pengajuan Retur",
            "pending" => "Menunggu Verifikasi",
            "berhasil" => "Pembayaran Berhasil",
            "gagal" => "Pembayaran Ditolak",
            "belum_bayar" => "Belum Dibayar",
            _ => string.IsNullOrWhiteSpace(status) ? "-" : status
        };
    }

    string StatusClass(string? status)
    {
        return (status ?? "").Trim().ToLowerInvariant() switch
        {
            "menunggu_bayar" or "pending" or "belum_bayar" => "waiting",
            "diproses" => "processing",
            "dikirim" => "shipping",
            "selesai" or "berhasil" => "success",
            "dibatalkan" or "gagal" => "failed",
            "retur" => "returning",
            _ => "neutral"
        };
    }

    var rupiah = System.Globalization.CultureInfo.GetCultureInfo("id-ID");
}

<style>
    .sync-orders-page {
        max-width: 1120px;
        margin: 0 auto;
        padding: 34px 18px 65px;
        color: #20382b;
    }

    .sync-orders-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .sync-orders-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #187347;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .sync-orders-eyebrow::before {
        content: "";
        width: 24px;
        height: 2px;
        background: #249461;
        border-radius: 10px;
    }

    .sync-orders-heading h1 {
        color: #173d2b;
        font-size: clamp(27px, 4vw, 36px);
        font-weight: 850;
        letter-spacing: -1px;
        margin: 0 0 7px;
    }

    .sync-orders-heading p {
        color: #7b8b80;
        margin: 0;
        font-size: 14px;
    }

    .sync-orders-heading-icon {
        width: 53px;
        height: 53px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #eaf5ed;
        color: #176b45;
        font-size: 23px;
    }

    .sync-orders-alert {
        border-radius: 12px;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .sync-orders-summary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 24px;
    }

    .sync-orders-summary-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 19px;
        border: 1px solid #e5eee7;
        background: white;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(24, 66, 42, .035);
    }

    .sync-orders-summary-icon {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: #176b45;
        background: #eaf5ed;
        font-size: 19px;
    }

    .sync-orders-summary-card span {
        display: block;
        color: #839187;
        font-size: 11px;
        margin-bottom: 4px;
        font-weight: 650;
    }

    .sync-orders-summary-card strong {
        display: block;
        color: #20382b;
        font-size: 20px;
        font-weight: 850;
    }

    .sync-orders-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin: 29px 0 16px;
    }

    .sync-orders-section-heading h3 {
        font-size: 17px;
        font-weight: 850;
        margin: 0;
        color: #20382b;
    }

    .sync-orders-section-heading span {
        font-size: 11px;
        color: #8b998f;
        font-weight: 700;
    }

    .sync-order-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .sync-order-card {
        overflow: hidden;
        border: 1px solid #e5eee7;
        border-radius: 17px;
        background: white;
        box-shadow: 0 6px 22px rgba(24, 66, 42, .035);
        transition: .2s ease;
    }

    .sync-order-card:hover {
        border-color: #c5ddcb;
        box-shadow: 0 10px 28px rgba(24, 66, 42, .07);
        transform: translateY(-2px);
    }

    .sync-order-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 17px 21px;
        background: #fbfdfb;
        border-bottom: 1px solid #edf2ee;
    }

    .sync-order-number {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .sync-order-number-icon {
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #176b45;
        background: #eaf5ed;
        border-radius: 11px;
        font-size: 17px;
    }

    .sync-order-number span {
        display: block;
        color: #8b998f;
        font-size: 10px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .sync-order-number strong {
        display: block;
        color: #20382b;
        font-size: 14px;
        font-weight: 850;
    }

    .sync-order-body {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 18px;
        padding: 20px 21px;
    }

    .sync-order-data span {
        display: block;
        color: #8b998f;
        font-size: 11px;
        font-weight: 650;
        margin-bottom: 7px;
    }

    .sync-order-data strong {
        display: block;
        color: #314638;
        font-size: 13px;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .sync-order-data strong.sync-order-total {
        color: #176b45;
        font-size: 17px;
        font-weight: 850;
    }

    .sync-order-payment {
        padding: 13px 21px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: #fbfdfb;
        border-top: 1px solid #edf2ee;
    }

    .sync-order-payment-info {
        min-width: 0;
    }

    .sync-order-payment-info span {
        display: block;
        color: #8b998f;
        font-size: 10px;
        font-weight: 650;
        margin-bottom: 4px;
    }

    .sync-order-payment-info strong {
        color: #405447;
        font-size: 12px;
        font-weight: 750;
    }

    .sync-order-footer {
        display: flex;
        justify-content: flex-end;
        padding: 0 21px 17px;
        background: #fbfdfb;
    }

    .sync-order-detail-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 9px 16px;
        border-radius: 9px;
        color: white;
        background: #176b45;
        border: 1px solid #176b45;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
        transition: .2s ease;
    }

    .sync-order-detail-btn:hover {
        color: white;
        background: #105536;
        transform: translateY(-2px);
    }

    .sync-order-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .sync-order-status.waiting {
        color: #94620b;
        background: #fff5dc;
    }

    .sync-order-status.processing {
        color: #235d9a;
        background: #e9f2ff;
    }

    .sync-order-status.shipping {
        color: #6548a1;
        background: #f0ebff;
    }

    .sync-order-status.success {
        color: #187347;
        background: #e8f6ec;
    }

    .sync-order-status.failed {
        color: #b33a43;
        background: #fff0f0;
    }

    .sync-order-status.returning {
        color: #9a5b20;
        background: #fff1e4;
    }

    .sync-order-status.neutral {
        color: #596b5e;
        background: #edf1ed;
    }

    .sync-orders-empty {
        padding: 55px 20px;
        text-align: center;
        border: 1px dashed #cbdccf;
        border-radius: 18px;
        background: #fbfdfb;
    }

    .sync-orders-empty-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 22px;
        color: #176b45;
        background: #eaf5ed;
        font-size: 31px;
    }

    .sync-orders-empty h3 {
        font-size: 19px;
        color: #20382b;
        font-weight: 850;
        margin-bottom: 8px;
    }

    .sync-orders-empty p {
        color: #849287;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .sync-orders-shop-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 19px;
        border-radius: 10px;
        background: #176b45;
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
    }

    .sync-orders-shop-btn:hover {
        color: white;
        background: #105536;
    }

    @@media (max-width: 650px) {
        .sync-orders-page {
            padding: 25px 13px 45px;
        }

        .sync-orders-summary {
            gap: 10px;
        }

        .sync-orders-summary-card {
            padding: 13px;
            gap: 10px;
        }

        .sync-orders-summary-icon {
            width: 37px;
            height: 37px;
            font-size: 16px;
        }

        .sync-orders-summary-card strong {
            font-size: 17px;
        }

        .sync-order-top {
            align-items: flex-start;
            flex-direction: column;
            padding: 15px;
        }

        .sync-order-body {
            grid-template-columns: 1fr 1fr;
            gap: 17px 12px;
            padding: 17px 15px;
        }

        .sync-order-payment {
            padding: 13px 15px;
        }

        .sync-order-footer {
            padding: 0 15px 15px;
        }

        .sync-order-detail-btn {
            width: 100%;
        }
    }

    @@media (max-width: 390px) {
        .sync-orders-summary {
            grid-template-columns: 1fr;
        }

        .sync-order-body {
            grid-template-columns: 1fr;
        }

        .sync-order-payment {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="sync-orders-page">

    <div class="sync-orders-heading">
        <div>
            <div class="sync-orders-eyebrow">ORDER HISTORY</div>
            <h1>Pesanan Saya</h1>
            <p>Pantau transaksi, pembayaran, dan perjalanan pesanan kamu.</p>
        </div>

        <div class="sync-orders-heading-icon">
            <i class="bi bi-receipt"></i>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success sync-orders-alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger sync-orders-alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="sync-orders-summary">

        <div class="sync-orders-summary-card">
            <div class="sync-orders-summary-icon">
                <i class="bi bi-bag-check"></i>
            </div>
            <div>
                <span>Total Pesanan</span>
                <strong>@daftarPesanan.Count</strong>
            </div>
        </div>

        <div class="sync-orders-summary-card">
            <div class="sync-orders-summary-icon">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <span>Total Transaksi</span>
                <strong>@daftarPesanan.Sum(x => x.TotalBayar).ToString("C0", rupiah)</strong>
            </div>
        </div>

    </div>

    <div class="sync-orders-section-heading">
        <h3>Riwayat Transaksi</h3>
        <span>@daftarPesanan.Count PESANAN</span>
    </div>

    @if (!daftarPesanan.Any())
    {
        <div class="sync-orders-empty">
            <div class="sync-orders-empty-icon">
                <i class="bi bi-bag-x"></i>
            </div>

            <h3>Belum Ada Pesanan</h3>
            <p>Pesanan yang kamu buat akan muncul di halaman ini.</p>

            <a asp-controller="Produk"
               asp-action="Index"
               class="sync-orders-shop-btn">
                <i class="bi bi-music-note-beamed"></i>
                Mulai Belanja
            </a>
        </div>
    }
    else
    {
        <div class="sync-order-list">

            @foreach (var item in daftarPesanan)
            {
                <article class="sync-order-card">

                    <div class="sync-order-top">

                        <div class="sync-order-number">
                            <div class="sync-order-number-icon">
                                <i class="bi bi-receipt-cutoff"></i>
                            </div>

                            <div>
                                <span>NOMOR PESANAN</span>
                                <strong>#@item.IdPemesanan</strong>
                            </div>
                        </div>

                        <span class="sync-order-status @StatusClass(item.StatusPesanan)">
                            @FormatStatus(item.StatusPesanan)
                        </span>

                    </div>

                    <div class="sync-order-body">

                        <div class="sync-order-data">
                            <span>Tanggal Pesanan</span>
                            <strong>@item.TglPesan.ToString("dd MMMM yyyy, HH:mm")</strong>
                        </div>

                        <div class="sync-order-data">
                            <span>Metode Pembayaran</span>
                            <strong>@item.NamaMetode</strong>
                        </div>

                        <div class="sync-order-data">
                            <span>Total Pembayaran</span>
                            <strong class="sync-order-total">
                                @item.TotalBayar.ToString("C0", rupiah)
                            </strong>
                        </div>

                    </div>

                    <div class="sync-order-payment">

                        <div class="sync-order-payment-info">
                            <span>STATUS PEMBAYARAN</span>
                            <strong>@FormatStatus(item.StatusPembayaran)</strong>
                        </div>

                        <span class="sync-order-status @StatusClass(item.StatusPembayaran)">
                            @FormatStatus(item.StatusPembayaran)
                        </span>

                    </div>

                    <div class="sync-order-footer">
                        <a asp-controller="PesananSaya"
                           asp-action="Detail"
                           asp-route-id="@item.IdPemesanan"
                           class="sync-order-detail-btn">
                            Lihat Detail Pesanan
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </article>
            }

        </div>
    }

</div>