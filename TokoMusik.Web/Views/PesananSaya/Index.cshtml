@model IEnumerable<TokoMusik.Web.Models.PesananViewModel>

@{
    ViewData["Title"] = "Pesanan Saya";

    var daftarPesanan = Model?.ToList()
        ?? new List<TokoMusik.Web.Models.PesananViewModel>();

    var rupiah = System.Globalization.CultureInfo.GetCultureInfo("id-ID");

    int jumlahRetur = daftarPesanan.Count(x =>
        !string.IsNullOrWhiteSpace(x.StatusRetur));

    string FormatStatus(string? status)
    {
        return (status ?? "").Trim().ToLowerInvariant() switch
        {
            "menunggu_bayar" => "Menunggu Pembayaran",
            "diproses" => "Sedang Diproses",
            "dikirim" => "Dalam Pengiriman",
            "selesai" => "Pesanan Selesai",
            "dibatalkan" => "Dibatalkan",
            "retur" => "Pengajuan Retur",
            "pending" => "Menunggu Verifikasi",
            "berhasil" => "Pembayaran Berhasil",
            "gagal" => "Pembayaran Ditolak",
            "belum_bayar" => "Belum Dibayar",
            _ => string.IsNullOrWhiteSpace(status) ? "-" : status
        };
    }

    string StatusClass(string? status)
    {
        return (status ?? "").Trim().ToLowerInvariant() switch
        {
            "menunggu_bayar" or "pending" or "belum_bayar" => "waiting",
            "diproses" => "processing",
            "dikirim" => "shipping",
            "selesai" or "berhasil" => "success",
            "dibatalkan" or "gagal" => "failed",
            "retur" => "returning",
            _ => "neutral"
        };
    }

    string StatusReturText(string? status)
    {
        return (status ?? "").Trim().ToLowerInvariant() switch
        {
            "diajukan" => "Pengajuan Diajukan",
            "disetujui" => "Retur Disetujui",
            "ditolak" => "Retur Ditolak",
            "selesai" => "Retur Selesai",
            _ => "-"
        };
    }

    string StatusReturClass(string? status)
    {
        return (status ?? "").Trim().ToLowerInvariant() switch
        {
            "diajukan" => "return-pending",
            "disetujui" => "return-approved",
            "ditolak" => "return-rejected",
            "selesai" => "return-completed",
            _ => "return-neutral"
        };
    }

    string FotoProduk(string? foto)
    {
        if (string.IsNullOrWhiteSpace(foto))
            return "/images/no-product.png";

        foto = foto.Trim();

        if (foto.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            foto.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return foto;

        if (foto.StartsWith("/", StringComparison.Ordinal))
            return foto;

        if (foto.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
            return "/" + foto;

        return "/uploads/produk/" + foto;
    }
}

