        .sync-orders-tabs {
            gap: 7px;
        }

        .sync-orders-tab {
            flex: 1 1 auto;
            padding: 9px 10px;
            font-size: 10px;
        }
    }

    @@media (max-width: 360px) {
        .sync-orders-summary {
            grid-template-columns: 1fr;
