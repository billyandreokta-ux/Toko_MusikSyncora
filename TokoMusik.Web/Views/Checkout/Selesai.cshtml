
@model TokoMusik.Web.Models.CheckoutSelesaiViewModel

@{
    ViewData["Title"] = "Pesanan Berhasil";

    var rupiah = System.Globalization.CultureInfo.GetCultureInfo("id-ID");
}

<style>
    .success-page {
        max-width: 1000px;
        margin: 35px auto 60px;
    }

    .success-hero {
        position: relative;
        overflow: hidden;
        padding: 48px 25px;
        border-radius: 22px;
        text-align: center;
        background: linear-gradient(135deg, #10291f, #101b17 65%, #17231d);
        border: 1px solid rgba(255,255,255,.09);
        color: #fff;
    }

    .success-hero::before,
    .success-hero::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(91, 190, 126, .08);
        pointer-events: none;
    }

    .success-hero::before {
        width: 230px;
        height: 230px;
        top: -120px;
        right: -55px;
    }

    .success-hero::after {
        width: 180px;
        height: 180px;
        bottom: -110px;
        left: -45px;
    }

    .success-check {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 78px;
        height: 78px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #d9f8e3;
        color: #168044;
        font-size: 40px;
        font-weight: 700;
        box-shadow: 0 0 0 9px rgba(217,248,227,.09);
    }

    .success-eyebrow {
        position: relative;
        z-index: 1;
        display: inline-block;
        margin-bottom: 10px;
        color: #a5e9ba;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .success-hero h1 {
        position: relative;
        z-index: 1;
        margin-bottom: 12px;
        font-size: clamp(25px, 4vw, 36px);
        font-weight: 750;
    }

    .success-hero p {
        position: relative;
        z-index: 1;
        max-width: 550px;
        margin: 0 auto;
        color: rgba(255,255,255,.72);
        line-height: 1.7;
    }

    .order-number-card {
        position: relative;
        z-index: 1;
        display: inline-flex;
        flex-direction: column;
        gap: 5px;
        margin-top: 28px;
        padding: 15px 35px;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 13px;
        background: rgba(255,255,255,.07);
    }

    .order-number-card span {
        color: rgba(255,255,255,.65);
        font-size: 12px;
    }

    .order-number-card strong {
        color: #fff;
        font-size: 27px;
        letter-spacing: 1px;
    }

    .success-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 22px;
    }

    .success-card {
        padding: 25px;
        border: 1px solid rgba(128,128,128,.2);
        border-radius: 17px;
        background: var(--bs-body-bg, #fff);
    }

    .success-card.full-width {
        grid-column: 1 / -1;
    }

    .success-card-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .success-card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 12px;
        background: rgba(35, 145, 83, .12);
        color: #26945a;
        font-size: 20px;
    }

    .success-card-heading h3 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
    }

    .success-card-heading p {
        margin: 3px 0 0;
        color: var(--bs-secondary-color);
        font-size: 12px;
    }

    .success-info-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(128,128,128,.15);
    }

    .success-info-row:last-child {
        padding-bottom: 0;
        border-bottom: 0;
    }

    .success-info-row span {
        color: var(--bs-secondary-color);
        font-size: 13px;
    }

    .success-info-row strong {
        text-align: right;
        font-size: 13px;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .address-detail {
        line-height: 1.8;
        font-size: 14px;
    }

    .payment-total {
        margin-top: 17px;
        padding: 17px;
        border-radius: 12px;
        background: rgba(35, 145, 83, .09);
    }

    .payment-total span {
        color: var(--bs-secondary-color);
        font-size: 13px;
    }

    .payment-total strong {
        display: block;
        margin-top: 5px;
        color: #26945a;
        font-size: 25px;
        font-weight: 750;
    }

    .payment-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 18px;
        padding: 14px;
        border-radius: 11px;
        background: rgba(255, 193, 7, .09);
        color: var(--bs-secondary-color);
        font-size: 13px;
        line-height: 1.6;
    }

    .success-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 25px;
    }

    .success-actions a {
        min-width: 190px;
        padding: 13px 22px;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        font-size: 14px;
        font-weight: 650;
        transition: .2s ease;
    }

    .btn-view-orders {
        background: #21864d;
        color: #fff;
        border: 1px solid #21864d;
    }

    .btn-view-orders:hover {
        background: #176b3b;
        border-color: #176b3b;
        color: #fff;
        transform: translateY(-2px);
    }

    .btn-continue-shopping {
        color: var(--bs-body-color);
        border: 1px solid rgba(128,128,128,.4);
        background: transparent;
    }

    .btn-continue-shopping:hover {
        background: rgba(128,128,128,.1);
        color: var(--bs-body-color);
    }

    @@media (max-width: 700px) {
        .success-page {
            margin: 20px auto 40px;
        }

        .success-hero {
            padding: 38px 18px;
        }

        .success-content {
            grid-template-columns: 1fr;
        }

        .success-card.full-width {
            grid-column: auto;
        }

        .success-card {
            padding: 20px;
        }

        .success-actions {
            flex-direction: column;
        }

        .success-actions a {
            width: 100%;
        }
    }
</style>

<div class="dashboard-container">
    <div class="success-page">

        <!-- HERO PESANAN BERHASIL -->
        <section class="success-hero">

            <div class="success-check">
                ✓
            </div>

            <span class="success-eyebrow">
                ORDER SUCCESSFUL
            </span>

            <h1>Pesanan Berhasil Dibuat!</h1>

            <p>
                Terima kasih telah mempercayakan kebutuhan musikmu kepada Syncora.
                Pesananmu telah berhasil dicatat dan sekarang dapat dipantau
                melalui halaman Pesanan Saya.
            </p>

            <div class="order-number-card">
                <span>Nomor Pesanan</span>
                <strong>#@Model.IdPemesanan</strong>
            </div>

        </section>

        <!-- INFORMASI PESANAN -->
        <div class="success-content">

            <section class="success-card">

                <div class="success-card-heading">
                    <div class="success-card-icon">▣</div>
                    <div>
                        <h3>Informasi Pesanan</h3>
                        <p>Ringkasan transaksi Anda</p>
                    </div>
                </div>

                <div class="success-info-row">
                    <span>Nomor Pesanan</span>
                    <strong>#@Model.IdPemesanan</strong>
                </div>

                <div class="success-info-row">
                    <span>Tanggal Pesanan</span>
                    <strong>
                        @Model.TanggalPesan.ToString("dd MMMM yyyy, HH:mm")
                    </strong>
                </div>

                <div class="success-info-row">
                    <span>Status Pesanan</span>
                    <strong>@Model.StatusPesanan</strong>
                </div>

                <div class="success-info-row">
                    <span>Metode Pembayaran</span>
                    <strong>@Model.NamaMetode</strong>
                </div>

            </section>

            <!-- ALAMAT PENGIRIMAN -->
            <section class="success-card">

                <div class="success-card-heading">
                    <div class="success-card-icon">⌖</div>
                    <div>
                        <h3>Alamat Pengiriman</h3>
                        <p>Tujuan pengiriman pesanan</p>
                    </div>
                </div>

                <div class="address-detail">
                    <strong>@Model.NamaPenerima</strong>
                    <div class="text-secondary mt-1">
                        @Model.Telepon
                    </div>

                    <div class="mt-3">
                        @Model.AlamatLengkap,
                        @Model.Kota,
                        @Model.Provinsi,
                        @Model.KodePos
                    </div>
                </div>

            </section>

            <!-- RINCIAN PEMBAYARAN -->
            <section class="success-card full-width">

                <div class="success-card-heading">
                    <div class="success-card-icon">Rp</div>
                    <div>
                        <h3>Rincian Pembayaran</h3>
                        <p>Periksa kembali ringkasan biaya pesanan Anda</p>
                    </div>
                </div>

                <div class="success-info-row">
                    <span>Subtotal Produk</span>
                    <strong>@Model.Subtotal.ToString("C0", rupiah)</strong>
                </div>

                <div class="success-info-row">
                    <span>Ongkos Kirim</span>
                    <strong>@Model.Ongkir.ToString("C0", rupiah)</strong>
                </div>

                <div class="success-info-row">
                    <span>Diskon</span>
                    <strong>@Model.Diskon.ToString("C0", rupiah)</strong>
                </div>

                <div class="payment-total">
                    <span>Total Pembayaran</span>
                    <strong>@Model.TotalBayar.ToString("C0", rupiah)</strong>
                </div>

                <div class="payment-note">
                    <span>ⓘ</span>
                    <div>
                        <strong>Informasi pembayaran</strong><br />
                        Pembayaran masih menunggu proses konfirmasi.
                        Silakan ikuti petunjuk pembayaran sesuai metode
                        yang telah Anda pilih. Anda dapat melihat detail
                        pesanan dan mengunggah bukti pembayaran melalui
                        halaman Pesanan Saya.
                    </div>
                </div>

            </section>

        </div>

        <!-- TOMBOL NAVIGASI -->
        <div class="success-actions">

            <a asp-controller="PesananSaya"
               asp-action="Index"
               class="btn-view-orders">
                Lihat Pesanan Saya →
            </a>

            <a asp-controller="Produk"
               asp-action="Index"
               class="btn-continue-shopping">
                Lanjutkan Belanja
            </a>

        </div>

    </div>
</div>
