
@model List<TokoMusik.Web.Models.AdminPesananGabunganViewModel>

@{
    ViewData["Title"] = "Pesanan Masuk";

    string StatusLabel(string? status)
    {
        return status switch
        {
            "menunggu_bayar" => "Menunggu Pembayaran",
            "diproses" => "Diproses",
            "dikirim" => "Dikirim",
            "selesai" => "Selesai",
            "dibatalkan" => "Dibatalkan",
            "pending" => "Menunggu Verifikasi",
            "berhasil" => "Berhasil",
            "gagal" => "Ditolak",
            "belum_bayar" => "Belum Dibayar",
            _ => status ?? "-"
        };
    }

    string StatusClass(string? status)
    {
        return status switch
        {
            "menunggu_bayar" or "pending" => "waiting",
            "diproses" or "berhasil" => "success",
            "dikirim" => "shipping",
            "selesai" => "completed",
            "gagal" or "dibatalkan" => "danger",
            _ => "neutral"
        };
    }
}

<style>
    .admin-order-page {
        max-width: 1240px;
        margin: 0 auto;
        padding: 38px 20px 65px;
        color: #263b30;
    }

    .admin-order-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 26px;
    }

    .admin-order-kicker {
        color: #719079;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .admin-order-heading h1 {
        font-size: clamp(26px, 4vw, 36px);
        font-weight: 800;
        letter-spacing: -1px;
        margin: 8px 0;
    }

    .admin-order-heading p {
        color: #829087;
        font-size: 13px;
        margin: 0;
    }

    .admin-order-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

    .admin-summary-card {
        background: #fff;
        border: 1px solid #e7ece6;
        border-radius: 12px;
        padding: 19px;
    }

    .admin-summary-card span {
        display: block;
        color: #849087;
        font-size: 11px;
        margin-bottom: 7px;
    }

    .admin-summary-card strong {
        display: block;
        color: #234d35;
        font-size: 25px;
        font-weight: 800;
    }

    .admin-order-panel {
        background: #fff;
        border: 1px solid #e7ece6;
        border-radius: 13px;
        overflow: hidden;
    }

    .admin-order-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        padding: 20px 22px;
        border-bottom: 1px solid #edf0eb;
    }

    .admin-order-panel-head h3 {
        font-size: 15px;
        font-weight: 800;
        margin: 0;
    }

    .admin-order-filter {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .admin-order-filter select {
        min-width: 180px;
        padding: 9px 12px;
        border: 1px solid #dfe7df;
        border-radius: 7px;
        color: #3c5143;
        background: #fff;
        font-size: 12px;
    }

    .admin-order-filter button {
        border: 0;
        border-radius: 7px;
        padding: 10px 14px;
        background: #174c35;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
    }

    .admin-order-table-wrap {
        overflow-x: auto;
    }

    .admin-order-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

    .admin-order-table th {
        padding: 14px 16px;
        background: #f7f9f6;
        color: #829087;
        text-align: left;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .admin-order-table td {
        padding: 16px;
        border-top: 1px solid #f0f2ee;
        font-size: 12px;
        vertical-align: middle;
    }

    .admin-order-table tbody tr:hover {
        background: #fbfcfa;
    }

    .admin-order-number {
        color: #245a3b;
        font-weight: 800;
    }

    .admin-order-customer strong {
        display: block;
        color: #35483a;
        font-size: 12px;
    }

    .admin-order-customer small {
        display: block;
        color: #9aa39b;
        margin-top: 4px;
    }

    .admin-order-date {
        color: #78857c;
        white-space: nowrap;
    }

    .admin-order-price {
        color: #294b36;
        font-weight: 800;
        white-space: nowrap;
    }

    .admin-status {
        display: inline-flex;
        align-items: center;
        border-radius: 30px;
        padding: 6px 10px;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }

    .admin-status.waiting {
        color: #986b19;
        background: #fff5dc;
    }

    .admin-status.success {
        color: #237347;
        background: #e8f5ec;
    }

    .admin-status.shipping {
        color: #27648a;
        background: #e8f3fa;
    }

    .admin-status.completed {
        color: #5c638a;
        background: #eef0fa;
    }

    .admin-status.danger {
        color: #a84943;
        background: #fcebea;
    }

    .admin-status.neutral {
        color: #69756d;
        background: #eff2ef;
    }

    .admin-order-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 13px;
        background: #174c35;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
    }

    .admin-order-action:hover {
        background: #286344;
        color: white;
    }

    .admin-order-empty {
        padding: 55px 20px;
        text-align: center;
        color: #849087;
    }

    .admin-order-empty strong {
        display: block;
        color: #425548;
        font-size: 16px;
        margin-bottom: 7px;
    }

    .admin-alert {
        padding: 13px 16px;
        border-radius: 8px;
        margin-bottom: 17px;
        font-size: 12px;
    }

    .admin-alert.success {
        color: #236b43;
        background: #e9f6ed;
    }

    .admin-alert.error {
        color: #a13e38;
        background: #fcebea;
    }

    @@media(max-width: 650px) {
        .admin-order-page {
            padding: 25px 14px 45px;
        }

        .admin-order-summary {
            grid-template-columns: 1fr;
        }

        .admin-order-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-order-panel-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-order-filter {
            width: 100%;
        }

        .admin-order-filter select {
            flex: 1;
            min-width: 0;
        }
    }
</style>

<div class="admin-order-page">

    <div class="admin-order-heading">
        <div>
            <div class="admin-order-kicker">Syncora / Administration</div>
            <h1>Pesanan Masuk</h1>
            <p>Kelola pesanan pelanggan dan verifikasi pembayaran dari satu tempat.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="admin-alert success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-alert error">@TempData["Error"]</div>
    }

    <div class="admin-order-summary">

        <div class="admin-summary-card">
            <span>Total Pesanan</span>
            <strong>@Model.Count</strong>
        </div>

        <div class="admin-summary-card">
            <span>Menunggu Pembayaran</span>
            <strong>@Model.Count(x => x.Status == "menunggu_bayar")</strong>
        </div>

        <div class="admin-summary-card">
            <span>Menunggu Verifikasi</span>
            <strong>@Model.Count(x => x.StatusPembayaran == "pending" && !string.IsNullOrWhiteSpace(x.BuktiBayar))</strong>
        </div>

    </div>

    <section class="admin-order-panel">

        <div class="admin-order-panel-head">
            <h3>Daftar Transaksi Pelanggan</h3>

            <form asp-controller="AdminPesanan"
                  asp-action="Index"
                  method="get"
                  class="admin-order-filter">

                <select name="status">
                    <option value="">Semua Status</option>
                    <option value="menunggu_bayar" selected="@(ViewBag.StatusFilter as string == "menunggu_bayar")">Menunggu Pembayaran</option>
                    <option value="diproses" selected="@(ViewBag.StatusFilter as string == "diproses")">Diproses</option>
                    <option value="dikirim" selected="@(ViewBag.StatusFilter as string == "dikirim")">Dikirim</option>
                    <option value="selesai" selected="@(ViewBag.StatusFilter as string == "selesai")">Selesai</option>
                    <option value="dibatalkan" selected="@(ViewBag.StatusFilter as string == "dibatalkan")">Dibatalkan</option>
                </select>

                <button type="submit">Filter</button>
            </form>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="admin-order-empty">
                <strong>Belum ada pesanan</strong>
                Pesanan pelanggan akan muncul di halaman ini.
            </div>
        }
        else
        {
            <div class="admin-order-table-wrap">
                <table class="admin-order-table">
                    <thead>
                        <tr>
                            <th>No. Pesanan</th>
                            <th>Pelanggan</th>
                            <th>Tanggal</th>
                            <th>Total</th>
                            <th>Pembayaran</th>
                            <th>Status Pesanan</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="admin-order-number">#@item.IdPemesanan</span>
                                </td>

                                <td class="admin-order-customer">
                                    <strong>@item.NamaCustomer</strong>
                                    <small>@@@item.Username</small>
                                </td>

                                <td class="admin-order-date">
                                    @item.TglPesan.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td class="admin-order-price">
                                    Rp @item.TotalBayar.ToString("N0")
                                </td>

                                <td>
                                    <span class="admin-status @StatusClass(item.StatusPembayaran)">
                                        @StatusLabel(item.StatusPembayaran)
                                    </span>

                                    @if (item.StatusPembayaran == "pending" &&
                                         !string.IsNullOrWhiteSpace(item.BuktiBayar))
                                    {
                                        <div style="margin-top:6px;color:#237347;font-size:10px;font-weight:700;">
                                            Bukti sudah diunggah
                                        </div>
                                    }
                                </td>

                                <td>
                                    <span class="admin-status @StatusClass(item.Status)">
                                        @StatusLabel(item.Status)
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="AdminPesanan"
                                       asp-action="Detail"
                                       asp-route-id="@item.IdPemesanan"
                                       class="admin-order-action">
                                        Lihat Detail →
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </section>

</div>
