
@{
    ViewData["Title"] = "Syncora - Find Your Sound";
    Layout = "_Layout";
}

<style>
    .syncora-home {
        --sync-green: #174c35;
        --sync-dark: #102f24;
        --sync-light: #e9f0e9;
        --sync-cream: #f8f7f2;
        --sync-text: #202923;
        color: var(--sync-text);
        background: var(--sync-cream);
        overflow: hidden;
    }

    .syncora-home * {
        box-sizing: border-box;
    }

    .syncora-container {
        width: min(1180px, calc(100% - 48px));
        margin: 0 auto;
    }

    .syncora-hero {
        min-height: 570px;
        display: flex;
        align-items: center;
        position: relative;
        background: #102f24;
        color: white;
        overflow: hidden;
    }

    .syncora-hero::before {
        content: "";
        position: absolute;
        width: 620px;
        height: 620px;
        right: -100px;
        top: -220px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50%;
    }

    .syncora-hero::after {
        content: "";
        position: absolute;
        width: 470px;
        height: 470px;
        right: -25px;
        top: -145px;
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 50%;
    }

    .syncora-hero-content {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1.05fr .95fr;
        align-items: center;
        gap: 45px;
        padding-top: 65px;
        padding-bottom: 65px;
    }

    .syncora-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #c7d8c8;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 23px;
    }

    .syncora-eyebrow::before {
        content: "";
        width: 28px;
        height: 1px;
        background: #a8c5aa;
    }

    .syncora-hero h1 {
        font-size: clamp(42px, 5.5vw, 68px);
        line-height: 1.08;
        letter-spacing: -2.5px;
        font-weight: 750;
        margin: 0 0 24px;
        max-width: 620px;
    }

    .syncora-hero h1 span {
        color: #a9c9a9;
    }

    .syncora-hero-description {
        max-width: 480px;
        color: #d1ddd4;
        font-size: 16px;
        line-height: 1.8;
        margin-bottom: 34px;
    }

    .syncora-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
    }

    .syncora-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 23px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .25s ease;
    }

    .syncora-btn-primary {
        background: #e5eee2;
        color: #173e2d;
    }

    .syncora-btn-primary:hover {
        background: white;
        color: #173e2d;
        transform: translateY(-2px);
    }

    .syncora-btn-outline {
        border: 1px solid rgba(255,255,255,.45);
        color: white;
    }

    .syncora-btn-outline:hover {
        background: rgba(255,255,255,.1);
        color: white;
    }

    .syncora-hero-visual {
        position: relative;
        min-height: 390px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .syncora-hero-image {
        width: 100%;
        max-width: 440px;
        height: 390px;
        object-fit: cover;
        border-radius: 5px;
        position: relative;
        z-index: 1;
        box-shadow: 20px 25px 60px rgba(0,0,0,.28);
    }

    .syncora-image-label {
        position: absolute;
        z-index: 2;
        left: 0;
        bottom: 15px;
        background: #f7f5ec;
        color: #173e2d;
        padding: 17px 22px;
        min-width: 185px;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .syncora-image-label small {
        display: block;
        font-size: 10px;
        letter-spacing: 2px;
        color: #718274;
        margin-bottom: 5px;
    }

    .syncora-image-label strong {
        font-size: 15px;
        letter-spacing: .5px;
    }

    /* Trust section */

    .syncora-benefits {
        background: #fff;
        border-bottom: 1px solid #e9e9e2;
    }

    .syncora-benefit-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        padding: 27px 0;
        gap: 25px;
    }

    .syncora-benefit {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .syncora-benefit-icon {
        width: 43px;
        height: 43px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #edf3ec;
        color: #24583d;
        font-size: 19px;
    }

    .syncora-benefit strong {
        display: block;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .syncora-benefit span {
        display: block;
        color: #81877f;
        font-size: 11px;
    }

    /* General section */

    .syncora-section {
        padding: 82px 0;
    }

    .syncora-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 35px;
    }

    .syncora-section-kicker {
        display: block;
        color: #6d8b70;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .syncora-section-heading h2 {
        font-size: clamp(27px, 3vw, 36px);
        letter-spacing: -1px;
        line-height: 1.2;
        color: #1b3025;
        margin: 0;
        font-weight: 750;
    }

    .syncora-section-heading p {
        color: #858b83;
        font-size: 13px;
        line-height: 1.7;
        max-width: 390px;
        margin: 10px 0 0;
    }

    .syncora-text-link {
        color: #24583d;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .syncora-text-link:hover {
        color: #63896a;
    }

    /* Categories */

    .syncora-categories {
        background: #f8f7f2;
    }

    .syncora-category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .syncora-category-card {
        display: block;
        position: relative;
        height: 270px;
        overflow: hidden;
        border-radius: 5px;
        background: #203c2d;
        text-decoration: none;
    }

    .syncora-category-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: .78;
        transition: transform .5s ease, opacity .5s ease;
    }

    .syncora-category-card:hover img {
        transform: scale(1.07);
        opacity: .95;
    }

    .syncora-category-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: end;
        padding: 22px;
        background: linear-gradient(transparent 25%, rgba(8,25,17,.85));
        color: white;
    }

    .syncora-category-overlay small {
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #d4e2d4;
        margin-bottom: 7px;
    }

    .syncora-category-overlay strong {
        font-size: 19px;
        font-weight: 700;
    }

    /* Products */

    .syncora-products {
        background: #fff;
    }

    .syncora-product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .syncora-product-card {
        min-width: 0;
        border: 1px solid #eceee8;
        background: white;
        border-radius: 5px;
        overflow: hidden;
        transition: .25s ease;
    }

    .syncora-product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(25,55,35,.09);
        border-color: #d6e2d5;
    }

    .syncora-product-image {
        height: 215px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f6f1;
        overflow: hidden;
    }

    .syncora-product-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 15px;
        transition: transform .3s ease;
    }

    .syncora-product-card:hover .syncora-product-image img {
        transform: scale(1.05);
    }

    .syncora-product-info {
        padding: 17px;
    }

    .syncora-product-category {
        color: #7b927d;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .syncora-product-name {
        color: #25352a;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.5;
        min-height: 42px;
        margin-bottom: 10px;
    }

    .syncora-product-price {
        color: #24583d;
        font-size: 15px;
        font-weight: 800;
        margin-bottom: 14px;
    }

    .syncora-product-detail {
        display: block;
        text-align: center;
        padding: 10px;
        border: 1px solid #dce6dc;
        color: #24583d;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        border-radius: 3px;
        transition: .2s ease;
    }

    .syncora-product-detail:hover {
        background: #174c35;
        border-color: #174c35;
        color: white;
    }

    .syncora-loading,
    .syncora-empty {
        grid-column: 1 / -1;
        padding: 45px 20px;
        text-align: center;
        color: #788078;
        background: #f7f8f4;
        border-radius: 5px;
        font-size: 13px;
    }

    /* Brand banner */

    .syncora-brand-banner {
        padding: 0 0 82px;
        background: white;
    }

    .syncora-banner-inner {
        min-height: 260px;
        padding: 45px 55px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        background: #174c35;
        color: white;
        position: relative;
        overflow: hidden;
        border-radius: 5px;
    }

    .syncora-banner-inner::after {
        content: "S";
        position: absolute;
        right: 60px;
        top: -100px;
        font-size: 350px;
        line-height: 1;
        font-weight: 800;
        color: rgba(255,255,255,.045);
        pointer-events: none;
    }

    .syncora-banner-content {
        position: relative;
        z-index: 1;
    }

    .syncora-banner-content small {
        display: block;
        color: #b9d2ba;
        font-size: 10px;
        letter-spacing: 3px;
        font-weight: 700;
        margin-bottom: 13px;
    }

    .syncora-banner-content h2 {
        font-size: clamp(25px, 3vw, 37px);
        line-height: 1.2;
        margin: 0 0 12px;
        letter-spacing: -1px;
    }

    .syncora-banner-content p {
        color: #d2dfd3;
        font-size: 13px;
        line-height: 1.7;
        margin: 0;
        max-width: 500px;
    }

    .syncora-banner-inner .syncora-btn {
        position: relative;
        z-index: 1;
        flex-shrink: 0;
    }

    @@media (max-width: 900px) {
        .syncora-hero-content {
            grid-template-columns: 1fr .85fr;
            gap: 25px;
        }

        .syncora-hero-image {
            height: 330px;
        }

        .syncora-category-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .syncora-product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .syncora-container {
            width: min(100% - 32px, 1180px);
        }

        .syncora-hero {
            min-height: auto;
        }

        .syncora-hero-content {
            grid-template-columns: 1fr;
            padding-top: 65px;
            padding-bottom: 55px;
        }

        .syncora-hero h1 {
            font-size: 43px;
        }

        .syncora-hero-description {
            font-size: 14px;
        }

        .syncora-hero-visual {
            min-height: 280px;
            margin-top: 10px;
        }

        .syncora-hero-image {
            height: 280px;
            max-width: 100%;
        }

        .syncora-image-label {
            left: 10px;
            bottom: 10px;
        }

        .syncora-benefit-grid {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 25px 0;
        }

        .syncora-section {
            padding: 60px 0;
        }

        .syncora-section-heading {
            align-items: start;
            flex-direction: column;
        }

        .syncora-category-card {
            height: 205px;
        }

        .syncora-category-overlay {
            padding: 14px;
        }

        .syncora-category-overlay strong {
            font-size: 16px;
        }

        .syncora-product-grid {
            gap: 12px;
        }

        .syncora-product-image {
            height: 155px;
        }

        .syncora-product-info {
            padding: 12px;
        }

        .syncora-product-name {
            font-size: 12px;
        }

        .syncora-product-price {
            font-size: 13px;
        }

        .syncora-banner-inner {
            padding: 35px 25px;
            align-items: start;
            flex-direction: column;
        }

        .syncora-brand-banner {
            padding-bottom: 55px;
        }
    }
</style>

