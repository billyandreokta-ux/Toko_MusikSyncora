</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const productGrid = document.getElementById("syncoraProductGrid");

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, function (char) {
                const entities = {
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#039;"
                };

                return entities[char];
            });
        }

        function getValue(item, ...keys) {
            for (const key of keys) {
                if (item && item[key] !== undefined && item[key] !== null) {
                    return item[key];
                }
            }

            return "";
        }

        function formatRupiah(value) {
            const number = Number(value);

            if (!Number.isFinite(number)) {
                return "Harga belum tersedia";
            }

            return new Intl.NumberFormat("id-ID", {
                style: "currency",
                currency: "IDR",
                maximumFractionDigits: 0
            }).format(number);
        }

        // Memperbaiki lokasi foto produk Syncora.
        function getImageUrl(photo) {
            if (!photo) {
                return "https://placehold.co/500x400/f1f3ed/45634d?text=Syncora";
            }

            const value = String(photo).trim();

            // Foto yang sudah berupa URL lengkap.
            if (value.startsWith("http://") || value.startsWith("https://")) {
                return value;
            }

            // Foto yang sudah memiliki path dari root website.
            if (value.startsWith("/")) {
                return value;
            }

            // Jika API sudah mengirim path uploads/produk/...
            if (value.toLowerCase().startsWith("uploads/")) {
                return "/" + value;
            }

            // Jika API hanya mengirim nama file, misalnya GTR-001.png.
            return "/uploads/produk/" + value;
        }

        function renderProducts(products) {
            if (!Array.isArray(products) || products.length === 0) {
                productGrid.innerHTML = `
                    <div class="syncora-empty">
                        Belum ada produk yang dapat ditampilkan.
                        <br />
                        Silakan periksa kembali katalog produk.
                    </div>
                `;
                return;
            }

            productGrid.innerHTML = products.slice(0, 4).map(function (item) {

                const id = getValue(item, "idProduk", "IdProduk", "id_produk");
                const name = getValue(item, "namaProduk", "NamaProduk", "nama_produk") || "Produk Syncora";
                const category = getValue(item, "namaCategory", "NamaCategory", "namaKategori", "NamaKategori") || "Instrumen Musik";
                const price = getValue(item, "hargaJual", "HargaJual", "harga_jual");
                const photo = getValue(item, "foto", "Foto", "gambar", "Gambar");
                const image = getImageUrl(photo);

                return `
                    <article class="syncora-product-card">
                        <div class="syncora-product-image">
                            <img
                                src="${escapeHtml(image)}"
                                alt="${escapeHtml(name)}"
                                loading="lazy"
                                onerror="this.onerror=null;this.src='https://placehold.co/500x400/f1f3ed/45634d?text=Syncora';" />
                        </div>

                        <div class="syncora-product-info">
                            <div class="syncora-product-category">
                                ${escapeHtml(category)}
                            </div>

                            <div class="syncora-product-name">
                                ${escapeHtml(name)}
                            </div>

                            <div class="syncora-product-price">
                                ${escapeHtml(formatRupiah(price))}
                            </div>

                            <a
                                href="/Produk/Detail/${encodeURIComponent(id)}"
                                class="syncora-product-detail">
                                Lihat Detail Produk →
                            </a>
                        </div>
                    </article>
                `;
            }).join("");
        }

        fetch("/api/produk")
            .then(function (response) {
                if (!response.ok) {
                    throw new Error("Gagal mengambil data produk.");
                }

                return response.json();
            })
            .then(function (result) {
                let products = result;

                if (!Array.isArray(products)) {
                    products =
                        result.data ||
                        result.Data ||
                        result.items ||
                        result.Items ||
                        result.produk ||
                        result.Produk ||
                        [];
                }

                renderProducts(products);
            })
            .catch(function (error) {
                console.error("Syncora product loading error:", error);

                productGrid.innerHTML = `
                    <div class="syncora-empty">
                        Produk belum dapat dimuat.
                        <br />
                        Silakan coba kembali beberapa saat lagi.
                    </div>
                `;
            });

    });
</script>
