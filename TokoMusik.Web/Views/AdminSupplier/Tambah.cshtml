
@model TokoMusik.Web.Models.SupplierViewModel

@{
    ViewData["Title"] = "Tambah Supplier";
}

<style>
    .supplier-form-page {
        max-width: 850px;
        margin: 35px auto 60px;
        color: #26352e;
    }

    .supplier-form-card {
        background: white;
        border: 1px solid #e7ece8;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 5px 20px rgba(25, 55, 39, .035);
    }

    .supplier-form-page h1 {
        font-size: 26px;
        font-weight: 750;
    }

    .supplier-form-page .form-label {
        font-size: 13px;
        font-weight: 650;
        color: #405349;
    }

    .supplier-form-page .form-control {
        min-height: 44px;
        border-radius: 9px;
        border-color: #dce5df;
    }

    .supplier-submit {
        background: #176b45;
        color: white;
        border: 0;
        border-radius: 9px;
        padding: 11px 20px;
        font-weight: 650;
    }

    .supplier-submit:hover {
        background: #105638;
    }
</style>

<div class="container supplier-form-page">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none" style="color:#176b45;">
            ← Kembali ke Supplier
        </a>
    </div>

    <div class="supplier-form-card">
        <h1>Tambah Supplier</h1>
        <p class="text-muted mb-4">
            Masukkan informasi pemasok baru untuk kebutuhan pengadaan produk.
        </p>

        <form asp-action="Tambah" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert"></div>

            <div class="mb-3">
                <label asp-for="NamaSupplier" class="form-label">Nama Supplier *</label>
                <input asp-for="NamaSupplier"
                       class="form-control"
                       placeholder="Contoh: PT Musik Sejahtera" />
                <span asp-validation-for="NamaSupplier" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Telepon" class="form-label">Nomor Telepon</label>
                    <input asp-for="Telepon"
                           class="form-control"
                           placeholder="08xxxxxxxxxx" />
                    <span asp-validation-for="Telepon" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="supplier@email.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Alamat" class="form-label">Alamat</label>
                <textarea asp-for="Alamat"
                          class="form-control"
                          rows="4"
                          placeholder="Masukkan alamat lengkap supplier"></textarea>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="supplier-submit">
                    Simpan Supplier
                </button>

                <a asp-action="Index"
                   class="btn btn-light border"
                   style="border-radius:9px;padding:11px 20px;">
                    Batal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
