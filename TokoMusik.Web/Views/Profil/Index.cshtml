
@model TokoMusik.Web.Models.ProfilViewModel

@{
    ViewData["Title"] = "Profil Saya";

    var fotoProfil = string.IsNullOrWhiteSpace(Model.Foto)
        ? null
        : Url.Content("~/uploads/profil/" + System.IO.Path.GetFileName(Model.Foto));

    var nama = string.IsNullOrWhiteSpace(Model.NamaCustomer)
        ? "Pengguna Syncora"
        : Model.NamaCustomer;

    var inisial = nama.Substring(0, 1).ToUpperInvariant();

    var email = string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email;
    var telepon = string.IsNullOrWhiteSpace(Model.Telepon) ? "-" : Model.Telepon;
    var username = string.IsNullOrWhiteSpace(Model.Username) ? "-" : Model.Username;
}

<style>
    .sync-profile-page {
        max-width: 1120px;
        margin: 0 auto;
        padding: 34px 18px 65px;
        color: #20382b;
    }

    .sync-profile-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #187347;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .sync-profile-eyebrow::before {
        content: "";
        width: 24px;
        height: 2px;
        background: #249461;
        border-radius: 10px;
    }

    .sync-profile-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 25px;
    }

    .sync-profile-heading h1 {
        font-size: clamp(27px, 4vw, 36px);
        font-weight: 850;
        letter-spacing: -1.2px;
        margin: 0 0 7px;
        color: #173d2b;
    }

    .sync-profile-heading p {
        color: #7b8b80;
        margin: 0;
        font-size: 14px;
    }

    .sync-profile-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e6eee8;
        border-radius: 22px;
        box-shadow: 0 15px 45px rgba(24, 66, 42, .07);
    }

    .sync-profile-cover {
        min-height: 175px;
        padding: 27px 32px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        background: linear-gradient(115deg, #104a32 0%, #176b45 55%, #27865a 100%);
    }

    .sync-profile-cover::before,
    .sync-profile-cover::after {
        content: "";
        position: absolute;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50%;
        pointer-events: none;
    }

    .sync-profile-cover::before {
        width: 280px;
        height: 280px;
        right: 8%;
        top: -175px;
    }

    .sync-profile-cover::after {
        width: 370px;
        height: 370px;
        right: -60px;
        top: -175px;
    }

    .sync-cover-content {
        position: relative;
        z-index: 1;
        color: white;
    }

    .sync-cover-content span {
        display: block;
        font-size: 11px;
        letter-spacing: 2px;
        font-weight: 800;
        opacity: .75;
        margin-bottom: 9px;
    }

    .sync-cover-content h2 {
        margin: 0;
        font-size: 23px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .sync-cover-content p {
        margin: 7px 0 0;
        color: rgba(255,255,255,.76);
        font-size: 13px;
    }

    .sync-cover-mark {
        position: relative;
        z-index: 1;
        width: 48px;
        height: 48px;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 1px solid rgba(255,255,255,.3);
        background: rgba(255,255,255,.1);
        border-radius: 15px;
        color: white;
    }

    .sync-cover-mark svg {
        width: 25px;
        height: 25px;
    }

    .sync-profile-body {
        padding: 0 34px 32px;
    }

    .sync-profile-identity {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: -47px;
        position: relative;
        z-index: 2;
        margin-bottom: 28px;
    }

    .sync-profile-avatar {
        width: 112px;
        height: 112px;
        flex-shrink: 0;
        border: 5px solid white;
        border-radius: 50%;
        object-fit: cover;
        background: #e5f3e9;
        color: #176b45;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 39px;
        font-weight: 850;
        box-shadow: 0 5px 20px rgba(20, 60, 38, .13);
    }

    .sync-profile-identity-info {
        min-width: 0;
        padding-top: 42px;
    }

    .sync-profile-identity-info h2 {
        font-size: 23px;
        font-weight: 850;
        color: #20382b;
        margin: 0 0 5px;
        overflow-wrap: anywhere;
    }

    .sync-profile-identity-info p {
        color: #7d8d82;
        font-size: 14px;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .sync-profile-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 10px;
        padding: 6px 11px;
        border-radius: 30px;
        background: #eaf6ee;
        color: #187347;
        font-size: 11px;
        font-weight: 800;
    }

    .sync-profile-status::before {
        content: "";
        width: 7px;
        height: 7px;
        background: #23985d;
        border-radius: 50%;
    }

    .sync-profile-divider {
        border: 0;
        border-top: 1px solid #edf1ed;
        margin: 0 0 27px;
    }

    .sync-profile-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 19px;
    }

    .sync-profile-section-heading h3 {
        color: #20382b;
        font-size: 17px;
        font-weight: 850;
        margin: 0;
    }

    .sync-profile-section-heading span {
        color: #94a197;
        font-size: 11px;
        font-weight: 700;
    }

    .sync-profile-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .sync-profile-info {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        padding: 18px;
        background: #fbfdfb;
        border: 1px solid #e9f0ea;
        border-radius: 14px;
        transition: .2s ease;
    }

    .sync-profile-info:hover {
        border-color: #b9d8c3;
        background: #f5faf6;
        transform: translateY(-2px);
    }

    .sync-info-icon {
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eaf5ed;
        color: #176b45;
    }

    .sync-info-icon svg {
        width: 21px;
        height: 21px;
        display: block;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .sync-info-content {
        min-width: 0;
    }

    .sync-info-content span {
        display: block;
        font-size: 11px;
        color: #849287;
        font-weight: 650;
        margin-bottom: 5px;
    }

    .sync-info-content strong {
        display: block;
        color: #263c2f;
        font-size: 14px;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .sync-profile-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid #edf1ed;
    }

    .sync-profile-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 17px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 750;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: .2s ease;
    }

    .sync-profile-btn svg {
        width: 17px;
        height: 17px;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .sync-profile-btn:hover {
        transform: translateY(-2px);
        text-decoration: none;
    }

    .sync-btn-edit {
        background: #176b45;
        border-color: #176b45;
        color: white;
    }

    .sync-btn-edit:hover {
        background: #105536;
        color: white;
    }

    .sync-btn-switch {
        background: #fff;
        border-color: #c9dfd0;
        color: #176b45;
    }

    .sync-btn-switch:hover {
        background: #edf7f0;
        color: #105536;
    }

    .sync-btn-home {
        background: #f7f9f7;
        border-color: #e4ebe5;
        color: #56685b;
    }

    .sync-btn-home:hover {
        background: #edf2ee;
        color: #263b30;
    }

    .sync-btn-logout {
        background: #fff;
        border-color: #f0d5d5;
        color: #c43f48;
    }

    .sync-btn-logout:hover {
        background: #fff2f2;
        color: #a92d37;
    }

    .sync-profile-actions form {
        margin: 0;
    }

    .sync-profile-alert {
        display: flex;
        align-items: center;
        gap: 9px;
        border-radius: 12px;
        margin-bottom: 18px;
        font-size: 13px;
    }

    .sync-profile-alert svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    @@media (max-width: 650px) {
        .sync-profile-page {
            padding: 25px 13px 45px;
        }

        .sync-profile-cover {
            min-height: 155px;
            padding: 23px 20px;
        }

        .sync-profile-body {
            padding: 0 19px 23px;
        }

        .sync-profile-identity {
            gap: 13px;
            margin-top: -40px;
            margin-bottom: 23px;
        }

        .sync-profile-avatar {
            width: 90px;
            height: 90px;
            font-size: 31px;
        }

        .sync-profile-identity-info {
            padding-top: 36px;
        }

        .sync-profile-identity-info h2 {
            font-size: 18px;
        }

        .sync-profile-identity-info p {
            font-size: 12px;
        }

        .sync-profile-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .sync-profile-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .sync-profile-actions form {
            display: flex;
        }

        .sync-profile-btn {
            width: 100%;
            padding: 10px 8px;
            font-size: 12px;
        }
    }

    @@media (max-width: 390px) {
        .sync-profile-heading {
            align-items: flex-start;
        }

        .sync-profile-cover {
            min-height: 140px;
        }

        .sync-cover-content h2 {
            font-size: 19px;
        }

        .sync-profile-identity {
            align-items: flex-start;
            flex-direction: column;
        }

        .sync-profile-identity-info {
            padding-top: 0;
        }

        .sync-profile-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="sync-profile-page">

    <div class="sync-profile-heading">
        <div>
            <div class="sync-profile-eyebrow">MY ACCOUNT</div>
            <h1>Profil Saya</h1>
            <p>Kelola informasi pribadi dan identitas akun Syncora kamu.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success sync-profile-alert">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12 2.5 2.5L16 9" />
            </svg>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger sync-profile-alert">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 8v5" />
                <path d="M12 16.5h.01" />
            </svg>
            @TempData["Error"]
        </div>
    }

    <div class="sync-profile-card">

        <div class="sync-profile-cover">
            <div class="sync-cover-content">
                <span>SYNCORA MEMBER AREA</span>
                <h2>Welcome to Syncora</h2>
                <p>One account, a better music experience.</p>
            </div>

            <div class="sync-cover-mark">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M9 18V5l12-2v13" />
                    <circle cx="6" cy="18" r="3" />
                    <circle cx="18" cy="16" r="3" />
                </svg>
            </div>
        </div>

        <div class="sync-profile-body">

            <div class="sync-profile-identity">

                @if (fotoProfil != null)
                {
                    <img src="@fotoProfil"
                         alt="Foto profil @nama"
                         class="sync-profile-avatar" />
                }
                else
                {
                    <div class="sync-profile-avatar">
                        @inisial
                    </div>
                }

                <div class="sync-profile-identity-info">
                    <h2>@nama</h2>
                    <p>@@@username</p>
                    <span class="sync-profile-status">Akun Aktif</span>
                </div>

            </div>

            <hr class="sync-profile-divider" />

            <div class="sync-profile-section-heading">
                <h3>Informasi Pribadi</h3>
                <span>ACCOUNT INFORMATION</span>
            </div>

            <div class="sync-profile-grid">

                <div class="sync-profile-info">
                    <div class="sync-info-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M5 21v-2a7 7 0 0 1 14 0v2" />
                        </svg>
                    </div>
                    <div class="sync-info-content">
                        <span>Nama Lengkap</span>
                        <strong>@nama</strong>
                    </div>
                </div>

                <div class="sync-profile-info">
                    <div class="sync-info-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M16 8v6a2 2 0 1 1-2-2h2" />
                            <path d="M16 8v8" />
                        </svg>
                    </div>
                    <div class="sync-info-content">
                        <span>Username</span>
                        <strong>@@@username</strong>
                    </div>
                </div>

                <div class="sync-profile-info">
                    <div class="sync-info-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="m3 7 9 6 9-6" />
                        </svg>
                    </div>
                    <div class="sync-info-content">
                        <span>Email</span>
                        <strong>@email</strong>
                    </div>
                </div>

                <div class="sync-profile-info">
                    <div class="sync-info-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 3h3l2 5-2.5 1.5a14 14 0 0 0 5 5L16 12l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 5 5a2 2 0 0 1 2-2z" />
                        </svg>
                    </div>
                    <div class="sync-info-content">
                        <span>Nomor Telepon</span>
                        <strong>@telepon</strong>
                    </div>
                </div>

            </div>

            <div class="sync-profile-actions">

                <a asp-controller="Profil"
                   asp-action="Edit"
                   class="sync-profile-btn sync-btn-edit">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z" />
                    </svg>
                    Edit Profil
                </a>

                <a asp-controller="Auth"
                   asp-action="PilihAkun"
                   class="sync-profile-btn sync-btn-switch">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M16 3h5v5" />
                        <path d="M4 20 21 3" />
                        <path d="M8 21H3v-5" />
                        <path d="M3 16 8 11" />
                    </svg>
                    Ganti Akun
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="sync-profile-btn sync-btn-home">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m3 10 9-7 9 7" />
                        <path d="M5 9v12h14V9" />
                        <path d="M9 21v-7h6v7" />
                    </svg>
                    Beranda
                </a>

                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post"
                      onsubmit="return confirm('Apakah Anda yakin ingin keluar dari akun user ini?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="sync-profile-btn sync-btn-logout">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M10 17l5-5-5-5" />
                            <path d="M15 12H3" />
                            <path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" />
                        </svg>
                        Logout
                    </button>

                </form>

            </div>

        </div>
    </div>
</div>
