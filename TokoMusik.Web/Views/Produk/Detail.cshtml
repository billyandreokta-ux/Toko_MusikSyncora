
@model dynamic

@{
    ViewData["Title"] = "Detail Produk";

    string namaProduk = Convert.ToString(Model.NamaProduk) ?? "Produk";
    string kodeProduk = Convert.ToString(Model.KodeProduk) ?? "-";
    string namaCategory = Convert.ToString(Model.NamaCategory) ?? "-";
    string namaMerk = Convert.ToString(Model.NamaMerk) ?? "-";
    string deskripsi = Convert.ToString(Model.Deskripsi) ?? "Belum ada deskripsi produk.";
    string foto = Convert.ToString(Model.Foto) ?? "";

    int idProduk = Convert.ToInt32(Model.IdProduk);
    int jumlahStok = Convert.ToInt32(Model.JumlahStok);

    decimal hargaProduk = Convert.ToDecimal(Model.HargaJual);

    string harga = hargaProduk.ToString(
        "C0",
        System.Globalization.CultureInfo.GetCultureInfo("id-ID")
    );

    string fotoUrl;

    if (string.IsNullOrWhiteSpace(foto))
    {
        fotoUrl = Url.Content("~/images/no-image.png");
    }
    else
    {
        foto = foto.Trim();

        if (foto.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            foto.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            fotoUrl = foto;
        }
        else if (foto.StartsWith("~/"))
        {
            fotoUrl = Url.Content(foto);
        }
        else if (foto.StartsWith("/"))
        {
            fotoUrl = foto;
        }
        else if (foto.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
        {
            fotoUrl = "/" + foto;
        }
        else
        {
            fotoUrl = Url.Content("~/uploads/produk/" + foto);
        }
    }

    string warna = Convert.ToString(Model.Warna) ?? "-";
    string bahan = Convert.ToString(Model.Bahan) ?? "-";
    string ukuran = Convert.ToString(Model.Ukuran) ?? "-";

    string berat = Model.BeratGram == null
        ? "-"
        : Convert.ToString(Model.BeratGram) + " gram";

    string spesifikasi = Convert.ToString(Model.Spesifikasi) ?? "-";
}

<style>
    .syncora-detail-page {
        --detail-green: #174c35;
        --detail-dark: #102f24;
        --detail-muted: #818c82;
        min-height: 100vh;
        padding: 36px 0 75px;
        background: #f8f7f2;
        color: #26382c;
    }

    .syncora-detail-page *,
    .syncora-detail-page *::before,
    .syncora-detail-page *::after {
        box-sizing: border-box;
    }

    .syncora-detail-container {
        width: min(1150px, calc(100% - 44px));
        margin: 0 auto;
    }

    /* BREADCRUMB */
    .syncora-detail-breadcrumb {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 9px;
        margin-bottom: 25px;
        color: #98a096;
        font-size: 10px;
    }

    .syncora-detail-breadcrumb a {
        color: #66836b;
        font-weight: 750;
        text-decoration: none;
    }

    .syncora-detail-breadcrumb a:hover {
        color: #174c35;
    }

    /* HEADER */
    .syncora-detail-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 23px;
    }

    .syncora-detail-heading small {
        display: block;
        margin-bottom: 8px;
        color: #789078;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 2.5px;
    }

    .syncora-detail-heading h1 {
        margin: 0 0 6px;
        color: #20392a;
        font-size: 27px;
        font-weight: 850;
        letter-spacing: -.7px;
    }

    .syncora-detail-heading p {
        margin: 0;
        color: #89918a;
        font-size: 11px;
    }

    .syncora-detail-back {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 0 15px;
        border: 1px solid #dce5da;
        border-radius: 5px;
        background: white;
        color: #45634d;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        transition: .2s ease;
    }

    .syncora-detail-back:hover {
        border-color: #174c35;
        background: #174c35;
        color: white;
    }

    /* ALERT */
    .syncora-detail-alert {
        padding: 13px 16px;
        margin-bottom: 17px;
        border-radius: 6px;
        font-size: 11px;
    }

    .syncora-detail-alert.success {
        border: 1px solid #cce4d0;
        background: #edf7ee;
        color: #28633c;
    }

    .syncora-detail-alert.error {
        border: 1px solid #f0d4d0;
        background: #fff0ee;
        color: #a64e48;
    }

    /* MAIN PRODUCT */
    .syncora-detail-main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 25px;
        align-items: start;
    }

    /* IMAGE */
    .syncora-detail-gallery {
        position: sticky;
        top: 25px;
        overflow: hidden;
        border: 1px solid #e7ebe3;
        border-radius: 8px;
        background: white;
        box-shadow: 0 8px 25px rgba(28,65,43,.045);
    }

    .syncora-detail-photo {
        position: relative;
        display: flex;
        min-height: 470px;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 35px;
        background: #f1f3ed;
    }

    .syncora-detail-photo::before,
    .syncora-detail-photo::after {
        position: absolute;
        border: 1px solid rgba(40,83,52,.08);
        border-radius: 50%;
        content: "";
        pointer-events: none;
    }

    .syncora-detail-photo::before {
        width: 350px;
        height: 350px;
    }

    .syncora-detail-photo::after {
        width: 260px;
        height: 260px;
    }

    .syncora-detail-photo img {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        max-height: 410px;
        object-fit: contain;
    }

    .syncora-detail-photo-caption {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        border-top: 1px solid #edf0eb;
        color: #879187;
        font-size: 9px;
    }

    .syncora-detail-photo-caption strong {
        color: #58735d;
        font-size: 9px;
        letter-spacing: 1px;
    }

    /* PRODUCT INFORMATION */
    .syncora-detail-information {
        padding: 27px;
        border: 1px solid #e7ebe3;
        border-radius: 8px;
        background: white;
        box-shadow: 0 8px 25px rgba(28,65,43,.045);
    }

    .syncora-detail-category {
        display: inline-flex;
        align-items: center;
        padding: 7px 10px;
        border-radius: 4px;
        background: #edf3ec;
        color: #63816a;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .syncora-detail-information h2 {
        margin: 15px 0 8px;
        color: #25392b;
        font-size: clamp(23px, 3vw, 31px);
        font-weight: 850;
        letter-spacing: -.8px;
        line-height: 1.3;
    }

    .syncora-detail-code {
        margin: 0;
        color: #929b92;
        font-size: 10px;
    }

    .syncora-detail-price-area {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin: 22px 0 17px;
        padding: 17px 0;
        border-top: 1px solid #edf0eb;
        border-bottom: 1px solid #edf0eb;
    }

    .syncora-detail-price-label {
        display: block;
        margin-bottom: 5px;
        color: #929b92;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .syncora-detail-price {
        color: #24583d;
        font-size: 27px;
        font-weight: 900;
        letter-spacing: -.5px;
    }

    .syncora-detail-stock {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 10px;
        border-radius: 4px;
        background: #edf7ee;
        color: #397449;
        font-size: 9px;
        font-weight: 800;
        white-space: nowrap;
    }

    .syncora-detail-stock::before {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6b9a70;
        content: "";
    }

    .syncora-detail-stock.empty {
        background: #fff0ee;
        color: #ad554b;
    }

    .syncora-detail-stock.empty::before {
        background: #bd5555;
    }

    /* PURCHASE PANEL */
    .syncora-purchase-panel {
        padding: 19px;
        margin-bottom: 23px;
        border: 1px solid #e5ebe2;
        border-radius: 6px;
        background: #fbfcf9;
    }

    .syncora-purchase-heading {
        margin-bottom: 15px;
    }

    .syncora-purchase-heading strong {
        display: block;
        margin-bottom: 5px;
        color: #314b37;
        font-size: 12px;
        font-weight: 850;
    }

    .syncora-purchase-heading span {
        color: #929b92;
        font-size: 10px;
    }

    .syncora-purchase-quantity {
        margin-bottom: 15px;
    }

    .syncora-purchase-quantity label {
        display: block;
        margin-bottom: 8px;
        color: #536056;
        font-size: 10px;
        font-weight: 800;
    }

    .syncora-quantity-input {
        display: flex;
        width: 145px;
        min-height: 42px;
        align-items: center;
        overflow: hidden;
        border: 1px solid #dce5da;
        border-radius: 5px;
        background: white;
    }

    .syncora-quantity-input input {
        width: 100%;
        height: 40px;
        padding: 0 10px;
        border: 0;
        outline: none;
        background: transparent;
        color: #294331;
        font-family: inherit;
        font-size: 13px;
        font-weight: 800;
        text-align: center;
    }

    .syncora-purchase-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .syncora-purchase-actions form {
        min-width: 0;
        margin: 0;
    }

    .syncora-buy-now,
    .syncora-add-cart {
        display: inline-flex;
        width: 100%;
        min-height: 46px;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 10px;
        border-radius: 5px;
        font-family: inherit;
        font-size: 10px;
        font-weight: 850;
        text-align: center;
        cursor: pointer;
        transition: .2s ease;
    }

    .syncora-buy-now {
        border: 1px solid #174c35;
        background: #174c35;
        color: white;
    }

    .syncora-buy-now:hover {
        border-color: #286347;
        background: #286347;
        color: white;
    }

    .syncora-add-cart {
        border: 1px solid #cbdacb;
        background: white;
        color: #28583a;
    }

    .syncora-add-cart:hover {
        border-color: #174c35;
        background: #edf4ed;
        color: #174c35;
    }

    .syncora-stock-empty-button {
        display: block;
        width: 100%;
        min-height: 45px;
        border: 0;
        border-radius: 5px;
        background: #e9ece7;
        color: #8b948b;
        font-family: inherit;
        font-size: 11px;
        font-weight: 800;
        cursor: not-allowed;
    }

    .syncora-login-button {
        display: flex;
        min-height: 45px;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        background: #174c35;
        color: white;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
        transition: .2s ease;
    }

    .syncora-login-button:hover {
        background: #286347;
        color: white;
    }

    .syncora-admin-note {
        padding: 13px;
        border-radius: 5px;
        background: #f1f4ef;
        color: #78847a;
        font-size: 10px;
        line-height: 1.7;
    }

    /* DESCRIPTION */
    .syncora-detail-description {
        padding: 19px 0;
        border-top: 1px solid #edf0eb;
    }

    .syncora-detail-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        color: #304637;
        font-size: 12px;
        font-weight: 850;
    }

    .syncora-detail-section-title::before {
        width: 3px;
        height: 16px;
        border-radius: 3px;
        background: #668d6c;
        content: "";
    }

    .syncora-detail-description p {
        margin: 0;
        color: #78847a;
        font-size: 11px;
        line-height: 1.9;
        white-space: pre-line;
    }

    /* SPECIFICATION */
    .syncora-detail-specification {
        padding-top: 18px;
        border-top: 1px solid #edf0eb;
    }

    .syncora-specification-list {
        margin-top: 12px;
    }

    .syncora-specification-row {
        display: grid;
        grid-template-columns: minmax(100px, .8fr) minmax(0, 1.2fr);
        gap: 15px;
        padding: 11px 0;
        border-bottom: 1px solid #f0f2ee;
        font-size: 10px;
    }

    .syncora-specification-row:last-child {
        border-bottom: 0;
    }

    .syncora-specification-row span {
        color: #929b92;
    }

    .syncora-specification-row strong {
        color: #405b46;
        font-weight: 750;
        text-align: right;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 850px) {
        .syncora-detail-main {
            grid-template-columns: 1fr;
        }

        .syncora-detail-gallery {
            position: static;
        }

        .syncora-detail-photo {
            min-height: 390px;
        }

        .syncora-detail-photo img {
            max-height: 340px;
        }
    }

    @@media (max-width: 520px) {
        .syncora-detail-container {
            width: calc(100% - 28px);
        }

        .syncora-detail-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .syncora-detail-heading h1 {
            font-size: 23px;
        }

        .syncora-detail-information {
            padding: 19px 15px;
        }

        .syncora-detail-photo {
            min-height: 280px;
            padding: 22px;
        }

        .syncora-detail-photo img {
            max-height: 245px;
        }

        .syncora-detail-price {
            font-size: 23px;
        }

        .syncora-purchase-panel {
            padding: 15px;
        }

        .syncora-purchase-actions {
            grid-template-columns: 1fr;
        }

        .syncora-specification-row {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="syncora-detail-page">

    <div class="syncora-detail-container">

        <!-- BREADCRUMB -->
        <nav class="syncora-detail-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Beranda</a>
            <span>/</span>
            <a asp-controller="Produk" asp-action="Index">Katalog Produk</a>
            <span>/</span>
            <span>Detail Produk</span>
        </nav>

        <!-- HEADER -->
        <div class="syncora-detail-heading">
            <div>
                <small>SYNCORA PRODUCT COLLECTION</small>
                <h1>Detail Produk</h1>
                <p>Kenali produk pilihanmu sebelum melakukan pembelian.</p>
            </div>

            <a asp-controller="Produk"
               asp-action="Index"
               class="syncora-detail-back">
                ← Kembali ke Katalog
            </a>
        </div>

        <!-- NOTIFIKASI -->
        @if (TempData["Success"] != null)
        {
            <div class="syncora-detail-alert success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="syncora-detail-alert error">
                @TempData["Error"]
            </div>
        }

        <div class="syncora-detail-main">

            <!-- FOTO PRODUK -->
            <section class="syncora-detail-gallery">

                <div class="syncora-detail-photo">
                    <img src="@fotoUrl"
                         alt="@namaProduk"
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/no-image.png")';" />
                </div>

                <div class="syncora-detail-photo-caption">
                    <span>SYNCORA • MUSIC COLLECTION</span>
                    <strong>PRODUCT IMAGE</strong>
                </div>

            </section>

            <!-- INFORMASI DAN PEMBELIAN -->
            <section class="syncora-detail-information">

                <span class="syncora-detail-category">
                    @namaCategory
                </span>

                <h2>@namaProduk</h2>

                <p class="syncora-detail-code">
                    Kode Produk: @kodeProduk
                </p>

                <div class="syncora-detail-price-area">
                    <div>
                        <span class="syncora-detail-price-label">
                            Harga Produk
                        </span>

                        <div class="syncora-detail-price">
                            @harga
                        </div>
                    </div>

                    @if (jumlahStok > 0)
                    {
                        <span class="syncora-detail-stock">
                            Stok: @jumlahStok
                        </span>
                    }
                    else
                    {
                        <span class="syncora-detail-stock empty">
                            Stok Habis
                        </span>
                    }
                </div>

                <!-- PILIHAN PEMBELIAN -->
                <div class="syncora-purchase-panel">

                    <div class="syncora-purchase-heading">
                        <strong>Pilihan Pembelian</strong>
                        <span>
                            Tentukan jumlah produk yang ingin kamu beli.
                        </span>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true &&
                         User.IsInRole("user"))
                    {
                        @if (jumlahStok > 0)
                        {
                            <div class="syncora-purchase-quantity">
                                <label for="jumlahPembelian">
                                    Jumlah Pembelian
                                </label>

                                <div class="syncora-quantity-input">
                                    <input type="number"
                                           id="jumlahPembelian"
                                           value="1"
                                           min="1"
                                           max="@jumlahStok"
                                           required />
                                </div>
                            </div>

                            <div class="syncora-purchase-actions">

                                <!-- FORM BELI SEKARANG -->
                                <form asp-controller="Checkout"
                                      asp-action="BeliSekarang"
                                      method="post"
                                      id="formBeliSekarang">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="idProduk"
                                           value="@idProduk" />

                                    <input type="hidden"
                                           name="jumlah"
                                           id="jumlahBeliSekarang"
                                           value="1" />

                                    <button type="submit"
                                            class="syncora-buy-now">
                                        Beli Sekarang <span>→</span>
                                    </button>
                                </form>

                                <!-- FORM TAMBAH KE KERANJANG -->
                                <form asp-controller="Keranjang"
                                      asp-action="Tambah"
                                      method="post"
                                      id="formTambahKeranjang">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="idProduk"
                                           value="@idProduk" />

                                    <input type="hidden"
                                           name="jumlah"
                                           id="jumlahTambahKeranjang"
                                           value="1" />

                                    <button type="submit"
                                            class="syncora-add-cart">
                                        + Tambah ke Keranjang
                                    </button>
                                </form>

                            </div>
                        }
                        else
                        {
                            <button type="button"
                                    class="syncora-stock-empty-button"
                                    disabled>
                                Stok Produk Habis
                            </button>
                        }
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="syncora-login-button">
                            Login untuk Berbelanja
                        </a>
                    }
                    else
                    {
                        <div class="syncora-admin-note">
                            Akun admin dapat mengelola produk melalui menu Manajemen Produk.
                        </div>
                    }

                </div>

                <!-- DESKRIPSI -->
                <div class="syncora-detail-description">
                    <h3 class="syncora-detail-section-title">
                        Deskripsi Produk
                    </h3>

                    <p>@deskripsi</p>
                </div>

                <!-- SPESIFIKASI -->
                <div class="syncora-detail-specification">
                    <h3 class="syncora-detail-section-title">
                        Informasi dan Spesifikasi
                    </h3>

                    <div class="syncora-specification-list">

                        <div class="syncora-specification-row">
                            <span>Merek</span>
                            <strong>@namaMerk</strong>
                        </div>

                        <div class="syncora-specification-row">
                            <span>Kategori</span>
                            <strong>@namaCategory</strong>
                        </div>

                        <div class="syncora-specification-row">
                            <span>Warna</span>
                            <strong>@warna</strong>
                        </div>

                        <div class="syncora-specification-row">
                            <span>Bahan</span>
                            <strong>@bahan</strong>
                        </div>

                        <div class="syncora-specification-row">
                            <span>Ukuran</span>
                            <strong>@ukuran</strong>
                        </div>

                        <div class="syncora-specification-row">
                            <span>Berat</span>
                            <strong>@berat</strong>
                        </div>

                        <div class="syncora-specification-row">
                            <span>Spesifikasi</span>
                            <strong>@spesifikasi</strong>
                        </div>

                    </div>
                </div>

            </section>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const jumlahPembelian = document.getElementById("jumlahPembelian");
        const jumlahBeliSekarang = document.getElementById("jumlahBeliSekarang");
        const jumlahTambahKeranjang = document.getElementById("jumlahTambahKeranjang");

        if (!jumlahPembelian) {
            return;
        }

        function sinkronkanJumlah() {
            const minimum = parseInt(jumlahPembelian.min || "1", 10);
            const maksimum = parseInt(jumlahPembelian.max || "1", 10);

            let jumlah = parseInt(jumlahPembelian.value || "1", 10);

            if (Number.isNaN(jumlah) || jumlah < minimum) {
                jumlah = minimum;
            }

            if (jumlah > maksimum) {
                jumlah = maksimum;
            }

            jumlahPembelian.value = jumlah;

            if (jumlahBeliSekarang) {
                jumlahBeliSekarang.value = jumlah;
            }

            if (jumlahTambahKeranjang) {
                jumlahTambahKeranjang.value = jumlah;
            }
        }

        jumlahPembelian.addEventListener("input", sinkronkanJumlah);
        jumlahPembelian.addEventListener("change", sinkronkanJumlah);

        const formBeliSekarang = document.getElementById("formBeliSekarang");
        const formTambahKeranjang = document.getElementById("formTambahKeranjang");

        if (formBeliSekarang) {
            formBeliSekarang.addEventListener("submit", function (event) {
                sinkronkanJumlah();

                if (!jumlahPembelian.reportValidity()) {
                    event.preventDefault();
                }
            });
        }

        if (formTambahKeranjang) {
            formTambahKeranjang.addEventListener("submit", function (event) {
                sinkronkanJumlah();

                if (!jumlahPembelian.reportValidity()) {
                    event.preventDefault();
                }
            });
        }

        sinkronkanJumlah();
    });
</script>
