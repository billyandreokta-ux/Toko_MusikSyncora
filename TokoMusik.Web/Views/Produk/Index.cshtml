
@model IEnumerable<TokoMusik.Web.Models.Produk>

@{
    ViewData["Title"] = "Katalog Produk";

    var daftarProduk = Model?.ToList() ?? new List<TokoMusik.Web.Models.Produk>();

    string GetFotoUrl(string? foto)
    {
        if (string.IsNullOrWhiteSpace(foto))
            return Url.Content("~/images/no-image.png");

        foto = foto.Trim();

        if (foto.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            foto.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return foto;

        if (foto.StartsWith("~/"))
            return Url.Content(foto);

        if (foto.StartsWith("/"))
            return foto;

        if (foto.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
            return "/" + foto;

        return Url.Content("~/uploads/produk/" + foto);
    }

    string FormatRupiah(decimal harga)
    {
        return harga.ToString(
            "C0",
            System.Globalization.CultureInfo.GetCultureInfo("id-ID")
        );
    }

    string cariAktif = Convert.ToString(ViewBag.Cari) ?? "";
    string urutkanAktif = Convert.ToString(ViewBag.Urutkan) ?? "nama";
    string stokAktif = Convert.ToString(ViewBag.Stok) ?? "semua";
}

<style>
    .syncora-catalog-page {
        --catalog-green: #174c35;
        --catalog-dark: #102f24;
        --catalog-muted: #7c897e;
        --catalog-cream: #f8f7f2;
        min-height: 100vh;
        padding-bottom: 75px;
        background: var(--catalog-cream);
        color: #26382c;
    }

    .syncora-catalog-page *,
    .syncora-catalog-page *::before,
    .syncora-catalog-page *::after {
        box-sizing: border-box;
    }

    .catalog-container {
        width: min(1200px, calc(100% - 44px));
        margin: 0 auto;
    }

    /* HERO */
    .catalog-hero {
        position: relative;
        overflow: hidden;
        padding: 58px 0 55px;
        background: linear-gradient(115deg, #102f24, #174c35 70%, #285b40);
        color: white;
    }

    .catalog-hero::before,
    .catalog-hero::after {
        position: absolute;
        content: "";
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 50%;
        pointer-events: none;
    }

    .catalog-hero::before {
        width: 570px;
        height: 570px;
        right: -110px;
        top: -300px;
    }

    .catalog-hero::after {
        width: 430px;
        height: 430px;
        right: -40px;
        top: -230px;
    }

    .catalog-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 35px;
    }

    .catalog-hero-copy {
        max-width: 700px;
    }

    .catalog-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        color: #c2d7c4;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .catalog-eyebrow::before {
        width: 25px;
        height: 1px;
        background: #a9c8ac;
        content: "";
    }

    .catalog-hero h1 {
        margin: 0 0 15px;
        color: white;
        font-size: clamp(32px, 4.5vw, 49px);
        font-weight: 850;
        letter-spacing: -1.8px;
        line-height: 1.15;
    }

    .catalog-hero h1 span {
        color: #b7d0b6;
    }

    .catalog-hero p {
        max-width: 560px;
        margin: 0;
        color: #d1dfd3;
        font-size: 13px;
        line-height: 1.9;
    }

    .catalog-hero-note {
        position: relative;
        z-index: 1;
        flex-shrink: 0;
        padding: 20px 23px;
        border: 1px solid rgba(255,255,255,.17);
        background: rgba(255,255,255,.07);
        backdrop-filter: blur(5px);
    }

    .catalog-hero-note small {
        display: block;
        margin-bottom: 7px;
        color: #b8d0ba;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .catalog-hero-note strong {
        color: white;
        font-size: 14px;
        letter-spacing: .3px;
    }

    /* FILTER */
    .catalog-filter-wrap {
        position: relative;
        z-index: 2;
        margin-top: -24px;
    }

    .catalog-filter {
        display: grid;
        grid-template-columns: 1.5fr 1.15fr 1fr 1fr;
        gap: 17px;
        padding: 24px;
        border: 1px solid #e7ebe3;
        border-radius: 10px;
        background: white;
        box-shadow: 0 12px 35px rgba(24, 51, 32, .07);
    }

    .catalog-filter-group {
        min-width: 0;
    }

    .catalog-filter-group label {
        display: block;
        margin-bottom: 8px;
        color: #536558;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .3px;
    }

    .catalog-filter input,
    .catalog-filter select {
        width: 100%;
        min-width: 0;
        height: 43px;
        padding: 0 12px;
        border: 1px solid #dfe6dc;
        border-radius: 5px;
        outline: none;
        background: #fbfcfa;
        color: #34473a;
        font-family: inherit;
        font-size: 11px;
        transition: .2s ease;
    }

    .catalog-filter input:focus,
    .catalog-filter select:focus {
        border-color: #668d6c;
        box-shadow: 0 0 0 3px rgba(84,131,101,.10);
        background: white;
    }

    .catalog-filter-actions {
        display: flex;
        align-items: end;
        gap: 9px;
    }

    .catalog-search-button,
    .catalog-reset {
        display: inline-flex;
        height: 43px;
        align-items: center;
        justify-content: center;
        padding: 0 17px;
        border-radius: 5px;
        font-family: inherit;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: .2s ease;
    }

    .catalog-search-button {
        flex: 1;
        border: 0;
        background: var(--catalog-green);
        color: white;
    }

    .catalog-search-button:hover {
        background: #286347;
    }

    .catalog-reset {
        border: 1px solid #d7e1d5;
        background: white;
        color: #45634d;
    }

    .catalog-reset:hover {
        background: #eaf0e8;
        color: #174c35;
    }

    .catalog-filter-secondary {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1fr 1fr 1.15fr;
        gap: 17px;
        padding-top: 15px;
        border-top: 1px solid #edf0eb;
    }

    /* RESULT HEADING */
    .catalog-content {
        padding-top: 48px;
    }

    .catalog-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 25px;
    }

    .catalog-section-heading small {
        display: block;
        margin-bottom: 8px;
        color: #718d73;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 2.3px;
        text-transform: uppercase;
    }

    .catalog-section-heading h2 {
        margin: 0;
        color: #20392a;
        font-size: 26px;
        font-weight: 850;
        letter-spacing: -.7px;
    }

    .catalog-result-count {
        padding: 9px 13px;
        border: 1px solid #e3e9df;
        border-radius: 5px;
        background: white;
        color: #738075;
        font-size: 10px;
    }

    .catalog-result-count strong {
        color: #24583d;
        font-weight: 850;
    }

    /* PRODUCT GRID */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 21px;
    }

    .product-card {
        display: flex;
        min-width: 0;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #e8ece5;
        border-radius: 8px;
        background: white;
        color: inherit;
        text-decoration: none;
        box-shadow: 0 4px 16px rgba(28,65,43,.025);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

    .product-card:hover {
        transform: translateY(-6px);
        border-color: #cfddce;
        color: inherit;
        box-shadow: 0 15px 35px rgba(28,65,43,.10);
    }

    .product-image {
        position: relative;
        display: flex;
        height: 225px;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 18px;
        background: #f3f5ef;
    }

    .product-image::after {
        position: absolute;
        right: -35px;
        bottom: -55px;
        width: 130px;
        height: 130px;
        border: 1px solid rgba(51,89,59,.08);
        border-radius: 50%;
        content: "";
        pointer-events: none;
    }

    .product-image img {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform .35s ease;
    }

    .product-card:hover .product-image img {
        transform: scale(1.06);
    }

    .product-image-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #93a294;
    }

    .product-image-placeholder span {
        font-size: 48px;
        line-height: 1;
    }

    .product-image-placeholder small {
        margin-top: 10px;
        font-size: 10px;
    }

    .product-info {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 17px;
    }

    .product-category {
        display: inline-block;
        margin-bottom: 8px;
        color: #78927b;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .product-info h3 {
        min-height: 42px;
        margin: 0 0 5px;
        color: #293b30;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.5;
    }

    .product-brand {
        margin: 0 0 14px;
        color: #929a91;
        font-size: 10px;
    }

    .product-price {
        margin-top: auto;
        margin-bottom: 12px;
        color: #24583d;
        font-size: 16px;
        font-weight: 900;
    }

    .product-stock {
        display: flex;
        align-items: center;
        gap: 7px;
        padding-top: 11px;
        border-top: 1px solid #edf0eb;
        color: #63816a;
        font-size: 10px;
        font-weight: 700;
    }

    .product-stock::before {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6b9a70;
        content: "";
    }

    .product-stock.stock-empty {
        color: #bd5555;
    }

    .product-stock.stock-empty::before {
        background: #bd5555;
    }

    .product-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 14px;
        padding: 10px 11px;
        border: 1px solid #dce6dc;
        border-radius: 4px;
        color: #24583d;
        font-size: 10px;
        font-weight: 800;
        transition: .2s ease;
    }

    .product-card:hover .product-card-footer {
        border-color: #174c35;
        background: #174c35;
        color: white;
    }

    /* EMPTY */
    .catalog-empty {
        grid-column: 1 / -1;
        padding: 65px 20px;
        border: 1px dashed #d8e2d6;
        border-radius: 8px;
        background: #fff;
        text-align: center;
    }

    .catalog-empty-icon {
        margin-bottom: 13px;
        color: #91a391;
        font-size: 42px;
    }

    .catalog-empty h3 {
        margin: 0 0 8px;
        color: #294331;
        font-size: 19px;
        font-weight: 850;
    }

    .catalog-empty p {
        margin: 0;
        color: #858e84;
        font-size: 12px;
    }

    .catalog-empty a {
        display: inline-flex;
        margin-top: 18px;
        padding: 12px 19px;
        border-radius: 5px;
        background: #174c35;
        color: white;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
    }

    .catalog-empty a:hover {
        background: #286347;
    }

    @@media (max-width: 1050px) {
        .catalog-filter {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .catalog-filter-secondary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .product-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 750px) {
        .catalog-hero {
            padding: 43px 0 50px;
        }

        .catalog-hero-content {
            align-items: flex-start;
            flex-direction: column;
        }

        .catalog-hero-note {
            padding: 14px 17px;
        }

        .product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 13px;
        }

        .product-image {
            height: 180px;
        }

        .product-info {
            padding: 13px;
        }
    }

    @@media (max-width: 480px) {
        .catalog-container {
            width: calc(100% - 28px);
        }

        .catalog-hero h1 {
            font-size: 33px;
        }

        .catalog-filter {
            grid-template-columns: 1fr;
            padding: 16px;
        }

        .catalog-filter-secondary {
            grid-template-columns: 1fr;
        }

        .catalog-filter-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .catalog-content {
            padding-top: 35px;
        }

        .catalog-section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .catalog-section-heading h2 {
            font-size: 22px;
        }

        .product-image {
            height: 145px;
            padding: 10px;
        }

        .product-info h3 {
            font-size: 12px;
        }

        .product-price {
            font-size: 13px;
        }

        .product-brand {
            font-size: 9px;
        }
    }
</style>

<div class="syncora-catalog-page">

    <!-- HERO KATALOG -->
    <section class="catalog-hero">
        <div class="catalog-container catalog-hero-content">

            <div class="catalog-hero-copy">
                <span class="catalog-eyebrow">SYNCORA COLLECTION</span>

                <h1>
                    Temukan Alat Musik<br />
                    <span>Favoritmu.</span>
                </h1>

                <p>
                    Jelajahi berbagai pilihan alat musik dan perlengkapan audio
                    untuk menemani perjalanan musikalmu. Temukan instrumen yang
                    sesuai dengan karakter dan kebutuhanmu bersama Syncora.
                </p>
            </div>

            <div class="catalog-hero-note">
                <small>YOUR MUSIC JOURNEY</small>
                <strong>Find Your Sound. Define Your Style.</strong>
            </div>

        </div>
    </section>

    <div class="catalog-container">

        <!-- FILTER PRODUK -->
        <div class="catalog-filter-wrap">

            <form method="get"
                  asp-controller="Produk"
                  asp-action="Index"
                  class="catalog-filter">

                <div class="catalog-filter-group">
                    <label for="cari">Pencarian Produk</label>
                    <input type="text"
                           id="cari"
                           name="cari"
                           value="@cariAktif"
                           placeholder="Nama, kode, merek..." />
                </div>

                <div class="catalog-filter-group">
                    <label for="kategori">Kategori</label>

                    <select id="kategori" name="kategori">
                        <option value="">Semua Kategori</option>

                        @if (ViewBag.Kategori != null)
                        {
                            @foreach (var item in ViewBag.Kategori)
                            {
                                if (ViewBag.KategoriTerpilih != null &&
                                    Convert.ToInt32(ViewBag.KategoriTerpilih) ==
                                    Convert.ToInt32(item.IdCategory))
                                {
                                    <option value="@item.IdCategory" selected>
                                        @item.NamaCategory
                                    </option>
                                }
                                else
                                {
                                    <option value="@item.IdCategory">
                                        @item.NamaCategory
                                    </option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="catalog-filter-group">
                    <label for="hargaMin">Harga Minimum</label>
                    <input type="number"
                           id="hargaMin"
                           name="hargaMin"
                           min="0"
                           step="1000"
                           value="@ViewBag.HargaMin"
                           placeholder="Rp minimum" />
                </div>

                <div class="catalog-filter-group">
                    <label for="hargaMax">Harga Maksimum</label>
                    <input type="number"
                           id="hargaMax"
                           name="hargaMax"
                           min="0"
                           step="1000"
                           value="@ViewBag.HargaMax"
                           placeholder="Rp maksimum" />
                </div>

                <div class="catalog-filter-secondary">

                    <div class="catalog-filter-group">
                        <label for="urutkan">Urutkan Produk</label>
                        <select id="urutkan" name="urutkan">
                            <option value="nama" selected="@(urutkanAktif == "nama")">
                                Nama Produk
                            </option>

                            <option value="terbaru" selected="@(urutkanAktif == "terbaru")">
                                Produk Terbaru
                            </option>

                            <option value="harga_terendah" selected="@(urutkanAktif == "harga_terendah")">
                                Harga Terendah
                            </option>

                            <option value="harga_tertinggi" selected="@(urutkanAktif == "harga_tertinggi")">
                                Harga Tertinggi
                            </option>
                        </select>
                    </div>

                    <div class="catalog-filter-group">
                        <label for="stok">Ketersediaan Stok</label>
                        <select id="stok" name="stok">
                            <option value="semua" selected="@(stokAktif == "semua")">
                                Semua Produk
                            </option>

                            <option value="tersedia" selected="@(stokAktif == "tersedia")">
                                Stok Tersedia
                            </option>

                            <option value="habis" selected="@(stokAktif == "habis")">
                                Stok Habis
                            </option>
                        </select>
                    </div>

                    <div class="catalog-filter-actions">
                        <button type="submit" class="catalog-search-button">
                            Cari Produk
                        </button>

                        <a asp-controller="Produk"
                           asp-action="Index"
                           class="catalog-reset">
                            Reset
                        </a>
                    </div>

                </div>
            </form>

        </div>

        <!-- DAFTAR PRODUK -->
        <section class="catalog-content">

            <div class="catalog-section-heading">
                <div>
                    <small>Explore Our Collection</small>
                    <h2>Daftar Produk</h2>
                </div>

                <div class="catalog-result-count">
                    Menampilkan <strong>@daftarProduk.Count</strong> produk
                </div>
            </div>

            <div class="product-grid">

                @if (daftarProduk.Any())
                {
                    @foreach (var item in daftarProduk)
                    {
                        string fotoUrl = GetFotoUrl(item.Foto);

                        <a class="product-card"
                           asp-controller="Produk"
                           asp-action="Detail"
                           asp-route-id="@item.IdProduk">

                            <div class="product-image">

                                @if (!string.IsNullOrWhiteSpace(item.Foto))
                                {
                                    <img src="@fotoUrl"
                                         alt="@item.NamaProduk"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/images/no-image.png")';" />
                                }
                                else
                                {
                                    <div class="product-image-placeholder">
                                        <span>♫</span>
                                        <small>Foto belum tersedia</small>
                                    </div>
                                }

                            </div>

                            <div class="product-info">

                                <span class="product-category">
                                    @(item.NamaCategory ?? "Instrumen Musik")
                                </span>

                                <h3>@item.NamaProduk</h3>

                                <p class="product-brand">
                                    @(item.NamaMerk ?? "Merek tidak tersedia")
                                </p>

                                <div class="product-price">
                                    @FormatRupiah(item.HargaJual)
                                </div>

                                @if (item.JumlahStok > 0)
                                {
                                    <div class="product-stock">
                                        Stok tersedia: @item.JumlahStok
                                    </div>
                                }
                                else
                                {
                                    <div class="product-stock stock-empty">
                                        Stok habis
                                    </div>
                                }

                                <div class="product-card-footer">
                                    <span>Lihat Detail Produk</span>
                                    <span>→</span>
                                </div>

                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="catalog-empty">
                        <div class="catalog-empty-icon">⌕</div>
                        <h3>Produk Tidak Ditemukan</h3>
                        <p>
                            Coba ubah kata pencarian atau sesuaikan filter produk.
                        </p>

                        <a asp-controller="Produk" asp-action="Index">
                            Tampilkan Semua Produk
                        </a>
                    </div>
                }

            </div>
        </section>

    </div>
</div>
