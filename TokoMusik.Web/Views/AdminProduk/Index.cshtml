
@model TokoMusik.Web.Models.AdminProdukViewModel

@{
    ViewData["Title"] = "Manajemen Produk";
    Layout = "_Layout";
}

<style>
    .syncora-manage {
        background: #f5f7f3;
        min-height: 100vh;
        padding: 38px 0 65px;
        color: #24352a;
    }

    .manage-container {
        width: min(1200px, calc(100% - 40px));
        margin: auto;
    }

    .manage-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .manage-heading small {
        color: #789078;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .manage-heading h1 {
        margin: 8px 0;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .manage-heading p {
        color: #89918a;
        font-size: 13px;
        margin: 0;
    }

    .manage-button {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 12px 17px;
        border: 0;
        border-radius: 5px;
        background: #174c35;
        color: white;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .manage-button:hover {
        background: #245f43;
        color: white;
    }

    .manage-alert {
        padding: 13px 16px;
        border-radius: 5px;
        margin-bottom: 18px;
        font-size: 12px;
        background: #e8f5e9;
        color: #28633c;
    }

    .manage-alert.error {
        background: #fcebea;
        color: #a64e48;
    }

    .manage-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 23px;
    }

    .manage-summary-card {
        background: white;
        border: 1px solid #e8ede6;
        border-radius: 6px;
        padding: 19px;
    }

    .manage-summary-card span {
        display: block;
        color: #8a948a;
        font-size: 11px;
        margin-bottom: 9px;
    }

    .manage-summary-card strong {
        display: block;
        color: #21432e;
        font-size: 25px;
        font-weight: 800;
    }

    .manage-panel {
        background: white;
        border: 1px solid #e8ede6;
        border-radius: 7px;
        overflow: hidden;
    }

    .manage-panel-top {
        padding: 19px 21px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        border-bottom: 1px solid #edf0eb;
    }

    .manage-panel-top h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 800;
    }

    .manage-panel-top p {
        color: #929b92;
        font-size: 11px;
        margin: 5px 0 0;
    }

    .manage-search {
        display: flex;
        gap: 8px;
    }

    .manage-search input {
        width: 240px;
        padding: 10px 12px;
        border: 1px solid #e2e8df;
        border-radius: 4px;
        outline: none;
        font-size: 12px;
    }

    .manage-search input:focus {
        border-color: #729477;
    }

    .manage-search button {
        padding: 10px 14px;
        background: #edf3eb;
        color: #24583d;
        border: 0;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
    }

    .manage-table-wrap {
        overflow-x: auto;
    }

    .manage-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

    .manage-table th {
        background: #fafbf8;
        color: #89938a;
        text-align: left;
        padding: 13px 16px;
        font-size: 10px;
        letter-spacing: .6px;
        text-transform: uppercase;
    }

    .manage-table td {
        padding: 13px 16px;
        border-top: 1px solid #f0f2ed;
        font-size: 12px;
        vertical-align: middle;
    }

    .manage-product {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 220px;
    }

    .manage-product img {
        width: 52px;
        height: 52px;
        object-fit: contain;
        background: #f3f5f0;
        border-radius: 5px;
        padding: 4px;
    }

    .manage-product strong {
        display: block;
        color: #263b2d;
        font-size: 12px;
        line-height: 1.5;
    }

    .manage-product span {
        display: block;
        color: #9ba39b;
        font-size: 10px;
        margin-top: 4px;
    }

    .manage-price {
        color: #24583d;
        font-weight: 800;
        white-space: nowrap;
    }

    .manage-status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        background: #e8f5e9;
        color: #397449;
        font-size: 10px;
        font-weight: 800;
    }

    .manage-status.inactive {
        background: #fcebea;
        color: #a64e48;
    }

    .manage-stock {
        font-weight: 800;
        color: #3d7047;
    }

    .manage-stock.low {
        color: #bd633f;
    }

    .manage-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .manage-action {
        display: inline-flex;
        padding: 7px 10px;
        border: 1px solid #e1e8df;
        border-radius: 4px;
        color: #315c3d;
        background: white;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
    }

    .manage-action:hover {
        background: #edf4ed;
    }

    .manage-action.danger {
        color: #a64e48;
        border-color: #f0d9d6;
    }

    .manage-action.danger:hover {
        background: #fcebea;
    }

    .manage-empty {
        text-align: center;
        padding: 45px 15px;
        color: #929b92;
        font-size: 12px;
    }

    @@media(max-width: 700px) {
        .manage-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .manage-summary {
            grid-template-columns: 1fr;
        }

        .manage-panel-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .manage-search {
            width: 100%;
        }

        .manage-search input {
            flex: 1;
            min-width: 0;
        }
    }
</style>

<div class="syncora-manage">
    <div class="manage-container">

        <div class="manage-heading">
            <div>
                <small>SYNCORA MANAGEMENT</small>
                <h1>Manajemen Produk</h1>
                <p>Kelola katalog, harga, kategori, merek, dan ketersediaan produk.</p>
            </div>

            <a href="/AdminProduk/Tambah" class="manage-button">
                + Tambah Produk
            </a>
        </div>

        @if (TempData["Sukses"] != null)
        {
            <div class="manage-alert">@TempData["Sukses"]</div>
        }

        @if (TempData["Gagal"] != null)
        {
            <div class="manage-alert error">@TempData["Gagal"]</div>
        }

        <div class="manage-summary">
            <div class="manage-summary-card">
                <span>Produk ditemukan</span>
                <strong>@Model.TotalProduk</strong>
            </div>

            <div class="manage-summary-card">
                <span>Produk stok menipis</span>
                <strong>@Model.TotalStokMenipis</strong>
            </div>

            <div class="manage-summary-card">
                <span>Katalog Syncora</span>
                <strong>Produk</strong>
            </div>
        </div>

        <section class="manage-panel">
            <div class="manage-panel-top">
                <div>
                    <h2>Daftar Produk</h2>
                    <p>Informasi produk yang tersimpan di database.</p>
                </div>

                <form method="get" action="/AdminProduk/Index" class="manage-search">
                    <input
                        type="text"
                        name="cari"
                        value="@Model.KataKunci"
                        placeholder="Cari nama atau kode produk..." />

                    <button type="submit">Cari</button>
                </form>
            </div>

            <div class="manage-table-wrap">
                <table class="manage-table">
                    <thead>
                        <tr>
                            <th>Produk</th>
                            <th>Kategori</th>
                            <th>Merek</th>
                            <th>Harga</th>
                            <th>Stok</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Produk.Any())
                        {
                            @foreach (var item in Model.Produk)
                            {
                                var statusAktif = string.Equals(
                                    item.Status,
                                    "aktif",
                                    StringComparison.OrdinalIgnoreCase);

                                var stokRendah = item.JumlahStok <= item.StokMinimum;

                                var foto = string.IsNullOrWhiteSpace(item.Foto)
                                    ? "/images/no-image.png"
                                    : item.Foto.StartsWith("/")
                                        ? item.Foto
                                        : "/uploads/produk/" + item.Foto;

                                <tr>
                                    <td>
                                        <div class="manage-product">
                                            <img
                                                src="@foto"
                                                alt="@item.NamaProduk"
                                                onerror="this.src='https://placehold.co/100x100/f1f3ed/45634d?text=No+Image'" />

                                            <div>
                                                <strong>@item.NamaProduk</strong>
                                                <span>@item.KodeProduk</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>@item.NamaCategory</td>
                                    <td>@item.NamaMerk</td>

                                    <td class="manage-price">
                                        @item.HargaJual.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                                    </td>

                                    <td>
                                        <span class="manage-stock @(stokRendah ? "low" : "")">
                                            @item.JumlahStok
                                        </span>
                                        <div style="font-size:10px;color:#9ba39b;margin-top:3px;">
                                            Minimum @item.StokMinimum
                                        </div>
                                    </td>

                                    <td>
                                        <span class="manage-status @(statusAktif ? "" : "inactive")">
                                            @(statusAktif ? "Aktif" : "Nonaktif")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="manage-actions">
                                            <a
                                                href="/AdminProduk/Edit/@item.IdProduk"
                                                class="manage-action">
                                                Edit
                                            </a>

                                            @if (statusAktif)
                                            {
                                                <form
                                                    method="post"
                                                    action="/AdminProduk/Nonaktifkan"
                                                    onsubmit="return confirm('Nonaktifkan produk ini?')">

                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.IdProduk" />

                                                    <button type="submit" class="manage-action danger">
                                                        Nonaktifkan
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form
                                                    method="post"
                                                    action="/AdminProduk/Aktifkan"
                                                    onsubmit="return confirm('Aktifkan kembali produk ini?')">

                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.IdProduk" />

                                                    <button type="submit" class="manage-action">
                                                        Aktifkan
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="manage-empty">
                                        Tidak ada produk yang ditemukan.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </div>
</div>