@model TokoMusik.Web.DTOs.RegisterRequest

@{
    ViewData["Title"] = "Daftar Akun";
}

<div class="auth-wrapper">
    <div class="auth-card auth-card-wide">
        <div class="auth-brand">
            <div class="auth-logo">TM</div>
            <h2>TokoMusik</h2>
            <p>Bergabung dan mulai belanja alat musik.</p>
        </div>

        <h3>Buat Akun Baru</h3>
        <p class="auth-subtitle">Lengkapi data berikut untuk mendaftar.</p>

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <form asp-controller="Auth" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="NamaCustomer">Nama Lengkap</label>
                <input asp-for="NamaCustomer"
                       class="form-control"
                       placeholder="Nama lengkap kamu" />
                <span asp-validation-for="NamaCustomer"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username"
                       class="form-control"
                       placeholder="Buat username" />
                <span asp-validation-for="Username"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="nama@email.com" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Telepon">Nomor Telepon</label>
                <input asp-for="Telepon"
                       class="form-control"
                       placeholder="08xxxxxxxxxx" />
                <span asp-validation-for="Telepon"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Minimal 6 karakter" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="KonfirmasiPassword">
                    Konfirmasi Password
                </label>
                <input asp-for="KonfirmasiPassword"
                       type="password"
                       class="form-control"
                       placeholder="Ulangi password" />
                <span asp-validation-for="KonfirmasiPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary-custom">
                Daftar Sekarang
            </button>
        </form>

        <div class="auth-footer">
            Sudah punya akun?
            <a asp-controller="Auth" asp-action="Login">Masuk</a>
        </div>
    </div>
</div>
