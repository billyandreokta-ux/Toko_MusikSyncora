
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TokoMusik</title>

    <link rel="stylesheet" href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="navbar">
        <div class="container nav-content">

            <a class="brand" asp-controller="Home"
               asp-action="Index">
                <span class="brand-icon">♫</span>
                TokoMusik
            </a>

            <nav>
                <a asp-controller="Home" asp-action="Index">
                    Beranda
                </a>

                <a href="/#produk">
                    Produk
                </a>

                <a href="/Auth/Login">
                    Login
                </a>
            </nav>

        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <p>
                © @DateTime.Now.Year TokoMusik.
                Sistem Penjualan Alat Musik.
            </p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
